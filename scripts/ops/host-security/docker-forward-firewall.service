[Unit]
Description=Restrict externally forwarded Docker ports
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/apply-giro-docker-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
