{
  // Production supplies HYPERDRIVE out-of-band; local/CI uses DATABASE_URL.
  // Never commit a Hyperdrive id or credential. DB routes return 503 if neither exists.
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "giro-project-service",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "AUDIT_SERVICE", "service": "giro-audit-service" },
    { "binding": "USER_SERVICE", "service": "giro-user-service" }
  ],
  "observability": { "enabled": true }
}
