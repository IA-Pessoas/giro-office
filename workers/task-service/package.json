{
  "name": "@workspace/task-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prisma:generate": "pnpm --filter @workspace/task-service prisma:generate",
    "pretest": "pnpm prisma:generate",
    "pretypecheck": "pnpm prisma:generate",
    "prebuild": "pnpm prisma:generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "biome check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@workspace/runtime": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/task-service": "workspace:*",
    "express": "^4.18.2",
    "iconv-lite": "0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/express": "^4.17.21",
    "@types/node": "^25.3.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.11"
  }
}
