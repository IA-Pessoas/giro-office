generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Recorte de infra/prisma/schema.prisma com o que o marketing-service do Node consulta.

model Organization {
  id                                 String                                  @id @default(uuid())
  timezone                           String                                  @default("UTC")
  users                              User[]                                  @relation("UserOrganization")
  departments                        Department[]
  rhRequests                         RhRequest[]
  tiRequests                         TIRequest[]
  passwordMkt                        PasswordMkt[]
  marketingAiUsageControls           MarketingAiUsageControl[]
  marketingAiUsageReconciliations    MarketingAiUsageImportReconciliation[]
  marketingEvents                    MarketingEvent[]
  marketingPasswordReconciliations   MarketingPasswordImportReconciliation[]

  @@map("organizations")
}

model Department {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  users           User[]

  @@map("departments")
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  full_name                String?
  status                   String
  organization_id          String?
  department_id            String
  organization             Organization?             @relation("UserOrganization", fields: [organization_id], references: [id])
  department               Department                @relation(fields: [department_id], references: [id])
  marketingAiUsageControls MarketingAiUsageControl[]

  @@map("users")
}

enum RhRequestUrgency {
  Low
  Medium
  High
}

enum RhRequestStatus {
  New
  In_Progress
  Resolved
  Closed
}

model RhRequest {
  id              String           @id @default(uuid())
  urgency         RhRequestUrgency
  status          RhRequestStatus
  organization_id String
  organization    Organization     @relation(fields: [organization_id], references: [id])

  @@map("rh.requests")
}

model TIRequest {
  id              String       @id @default(uuid())
  urgency         String
  status          String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("tecnologia.requests")
}

model PasswordMkt {
  id              String       @id @default(uuid())
  local           String
  user            String
  password        String
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("mtk.passwords")
}

model MarketingAiUsageControl {
  id              String       @id @default(uuid())
  organization_id String
  user_id         String
  competence      DateTime     @db.Date
  knowledge       Boolean?
  integration     Boolean?
  frequency       Int?
  purpose         String?
  perceived_gain  String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, competence], map: "uq_marketing_ai_usage_controls_org_user_competence")
  @@index([organization_id, competence], map: "idx_marketing_ai_usage_controls_org_competence")
  @@index([user_id], map: "idx_marketing_ai_usage_controls_user")
  @@map("marketing.ai_usage_controls")
}

model MarketingAiUsageImportReconciliation {
  id                 String       @id @default(uuid())
  organization_id    String
  legacy_user_id     String
  legacy_competence  String
  payload            Json
  reason             String
  status             String       @default("pending")
  created_at         DateTime     @default(now())
  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, legacy_user_id, legacy_competence], map: "uq_marketing_ai_usage_reconciliation_org_user_competence")
  @@index([organization_id, status, created_at], map: "idx_marketing_ai_usage_reconciliation_org_status")
  @@map("marketing.ai_usage_import_reconciliation")
}

model MarketingEvent {
  id              String       @id @default(uuid())
  organization_id String
  name            String       @db.VarChar(50)
  name_key        String       @db.VarChar(50)
  legacy_id       Int?
  logo            String       @default("") @db.VarChar(100)
  status          String       @default("Novo") @db.VarChar(25)
  priority        String       @db.VarChar(15)
  objective       String       @default("")
  audience        String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  editions        MarketingEventEdition[]

  @@unique([id, organization_id], map: "mtk.events_id_organization_unique")
  @@unique([organization_id, name_key], map: "mtk.events_organization_name_key_unique")
  @@unique([organization_id, legacy_id], map: "mtk.events_organization_legacy_id_unique")
  @@index([organization_id, status], map: "mtk.events_organization_status_idx")
  @@map("mtk.events")
}

model MarketingEventEdition {
  id                       String                            @id @default(uuid())
  organization_id          String
  event_id                 String
  legacy_id                Int?
  name                     String                            @db.VarChar(100)
  date                     DateTime                          @db.Date
  place                    String                            @db.VarChar(255)
  partnerships             Json                              @default("[]") @db.JsonB
  organizing_team          Json                              @default("[]") @db.JsonB
  logistics                Json                              @default("{}") @db.JsonB
  marketing_communication  Json                              @default("{}") @db.JsonB
  during_event             Json                              @default("{}") @db.JsonB
  after_event              Json                              @default("{}") @db.JsonB
  notes                    String                            @default("")
  feedback_period_start    DateTime?                         @db.Timestamp(3)
  feedback_period_end      DateTime?                         @db.Timestamp(3)
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @default(now()) @updatedAt
  event                    MarketingEvent                    @relation(fields: [event_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: Cascade)
  budgetItems              MarketingEventEditionBudgetItem[]
  feedback                 MarketingEventEditionFeedback?

  @@unique([id, organization_id], map: "mtk.event_editions_id_organization_unique")
  @@unique([organization_id, legacy_id], map: "mtk.event_editions_organization_legacy_unique")
  @@index([organization_id, event_id, date], map: "mtk.event_editions_event_date_idx")
  @@map("mtk.event_editions")
}

model MarketingEventEditionBudgetItem {
  id              String                @id @default(uuid())
  organization_id String
  edition_id      String
  legacy_id       String?               @db.VarChar(100)
  name            String                @db.VarChar(100)
  amount          Decimal               @db.Decimal(12, 2)
  position        Int                   @default(0)
  edition         MarketingEventEdition @relation(fields: [edition_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, organization_id], map: "mtk.event_edition_budget_items_id_organization_unique")
  @@unique([organization_id, edition_id, legacy_id], map: "mtk.event_edition_budget_items_edition_legacy_unique")
  @@index([organization_id, edition_id, position], map: "mtk.event_edition_budget_items_edition_idx")
  @@map("mtk.event_edition_budget_items")
}

model MarketingEventEditionFeedback {
  id              String                @id @default(uuid())
  organization_id String
  edition_id      String
  rating          Int
  observation     String?               @db.Text
  evaluated_at    DateTime              @db.Timestamp(3)
  edition         MarketingEventEdition @relation(fields: [edition_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([edition_id, organization_id], map: "mtk.event_edition_feedback_edition_unique")
  @@map("mtk.event_edition_feedback")
}

model MarketingPasswordImportReconciliation {
  id                 String       @id @default(uuid())
  organization_id    String
  encrypted_payload  String
  reason             String
  status             String       @default("pending")
  created_at         DateTime     @default(now())
  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status, created_at], map: "idx_marketing_password_import_reconciliation_org_status")
  @@map("marketing.password_import_reconciliation")
}

