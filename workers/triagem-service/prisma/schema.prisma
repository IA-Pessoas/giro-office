generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                         String                             @id
  clients                    Client[]
  users                      User[]
  triageCatalogItems         TriageCatalogItem[]
  triageConfigs              TriageConfig[]
  triageMonthlys             TriageMonthly[]
  triageBankStatements       TriageBankStatement[]
  triageClosings              TriageClosing[]
  triageResponsibles         TriageResponsible[]
  triageCompetences          TriageCompetence[]
  triageCatalogSnapshots     TriageCompetenceCatalogSnapshot[]
  triageExternalLinks        TriageExternalLink[]
  triageUrgentRequests       TriageUrgentRequest[]
  triageCompetenceHistories  TriageCompetenceHistory[]
  triageOutboxEvents         TriageOutboxEvent[]

  @@map("organizations")
}

model Client {
  id                  String                  @id
  name                String
  company_name        String?
  organization_id     String
  organization        Organization            @relation(fields: [organization_id], references: [id])
  triageConfigs       TriageConfig[]
  triageMonthlys      TriageMonthly[]
  triageBankStatements TriageBankStatement[]
  triageClosings      TriageClosing[]
  triageResponsibles  TriageResponsible[]
  triageCompetences   TriageCompetence[]
  triageExternalLinks TriageExternalLink[]
  triageUrgentRequests TriageUrgentRequest[]

  @@map("clients")
}

model User {
  id                          String                     @id
  name                        String
  full_name                   String?
  status                      String?
  organization_id             String
  organization                Organization               @relation(fields: [organization_id], references: [id])
  triageResponsibles          TriageResponsible[]
  triageMonthlyResponsible    TriageMonthly[]
  triageExternalLinksResponsible TriageExternalLink[] @relation("TriageExternalLinkResponsible")
  triageUrgentRequestsRequested TriageUrgentRequest[] @relation("TriageUrgentRequestRequester")
  triageUrgentRequestsResponsible TriageUrgentRequest[] @relation("TriageUrgentRequestResponsible")
  triageCompetenceHistories   TriageCompetenceHistory[]

  @@map("users")
}

model TriageCatalogItem {
  id              String   @id @default(uuid())
  organization_id String
  kind            String
  code            String
  label           String
  url             String?
  archived_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  snapshots       TriageCompetenceCatalogSnapshot[]

  @@unique([id, organization_id])
  @@unique([organization_id, kind, code])

  @@map("triagem.catalog_items")
}

model TriageConfig {
  id              String       @id @default(uuid())
  client_id       String
  type            String
  active_items    Json
  updated_at      DateTime     @updatedAt
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, client_id, type])
  @@map("triagem.configs")
}

model TriageMonthly {
  id              String       @id @default(uuid())
  client_id       String
  competence      String
  type            String
  checklist       Json
  item_notes      Json         @default("{}")
  download_date   DateTime?
  settlement_date DateTime?
  billing_amount  String?
  triad_moviment  Boolean      @default(false)
  responsible_id  String?
  notes           String?
  justification   String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  archived_at     DateTime?
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  responsible     User?        @relation(fields: [responsible_id], references: [id])

  @@map("triagem.monthly")
}

model TriageBankStatement {
  id              String       @id @default(uuid())
  client_id       String
  competence      String
  bank_id         String
  status          String       @default("PENDING")
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  archived_at     DateTime?
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("triagem.bank_statements")
}

model TriageClosing {
  id              String       @id @default(uuid())
  client_id       String
  competence      String
  status          String
  archived_at     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("triagem.closings")
}

model TriageResponsible {
  id              String       @id @default(uuid())
  client_id       String
  user_id         String
  type            String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@unique([organization_id, client_id, type])
  @@map("triagem.responsibles")
}

model TriageCompetence {
  id                              String                             @id @default(uuid())
  organization_id                String
  client_id                      String
  competence                     String
  configuration_snapshot         Json
  responsible_snapshot           Json
  catalog_snapshot_initialized_at DateTime?
  archived_at                    DateTime?
  created_at                     DateTime                           @default(now())
  updated_at                     DateTime                           @updatedAt
  organization                   Organization                       @relation(fields: [organization_id], references: [id])
  client                         Client                             @relation(fields: [client_id], references: [id])
  history                        TriageCompetenceHistory[]
  catalog_snapshots              TriageCompetenceCatalogSnapshot[]
  outbox_events                  TriageOutboxEvent[]

  @@unique([id, organization_id])
  @@unique([organization_id, client_id, competence])
  @@map("triagem.competences")
}

model TriageCompetenceCatalogSnapshot {
  id              String          @id @default(uuid())
  organization_id String
  competence_id   String
  catalog_item_id String
  kind            String
  code            String
  label           String
  url             String?
  created_at      DateTime        @default(now())
  organization    Organization    @relation(fields: [organization_id], references: [id])
  competence      TriageCompetence @relation(fields: [competence_id, organization_id], references: [id, organization_id])
  catalog_item    TriageCatalogItem @relation(fields: [catalog_item_id, organization_id], references: [id, organization_id])

  @@unique([organization_id, competence_id, catalog_item_id])
  @@map("triagem.competence_catalog_snapshots")
}

model TriageExternalLink {
  id              String       @id @default(uuid())
  organization_id String
  client_id       String
  competence      String
  type            String
  url             String
  description     String?
  responsible_id  String?
  archived_at     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  client          Client       @relation(fields: [client_id], references: [id])
  responsible     User?        @relation("TriageExternalLinkResponsible", fields: [responsible_id], references: [id])

  @@map("triagem.external_links")
}

model TriageUrgentRequest {
  id              String       @id @default(uuid())
  organization_id String
  client_id       String
  competence      String
  requester_id    String
  responsible_id  String
  urgency_code    String
  description     String
  status          String       @default("OPEN")
  resolution_note String?
  resolved_at     DateTime?
  dedupe_key      String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  client          Client       @relation(fields: [client_id], references: [id])
  requester       User         @relation("TriageUrgentRequestRequester", fields: [requester_id], references: [id])
  responsible     User         @relation("TriageUrgentRequestResponsible", fields: [responsible_id], references: [id])

  @@unique([organization_id, dedupe_key])
  @@map("triagem.urgent_requests")
}

model TriageCompetenceHistory {
  id              String          @id @default(uuid())
  competence_id   String
  organization_id String
  actor_user_id   String
  action          String
  before_data     Json?
  after_data      Json
  idempotency_key String          @unique
  created_at      DateTime        @default(now())
  competence      TriageCompetence @relation(fields: [competence_id], references: [id])
  organization    Organization    @relation(fields: [organization_id], references: [id])
  actor           User            @relation(fields: [actor_user_id], references: [id])

  @@map("triagem.competence_history")
}

model TriageOutboxEvent {
  id              String          @id @default(uuid())
  event_key       String          @unique
  aggregate_type  String
  aggregate_id    String
  competence_id   String
  organization_id String
  event_type      String
  payload         Json
  occurred_at     DateTime        @default(now())
  dispatched_at   DateTime?
  attempts        Int             @default(0)
  competence      TriageCompetence @relation(fields: [competence_id], references: [id])
  organization    Organization    @relation(fields: [organization_id], references: [id])

  @@map("triagem.outbox_events")
}
