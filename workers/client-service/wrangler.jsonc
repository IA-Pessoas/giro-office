{
  // BLOCKED: declare HYPERDRIVE here once an authorized production ID exists.
  // Without it the Worker falls back to DATABASE_URL, and neither is configured,
  // so createWorkerPrismaClient throws on the first query.
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "giro-client-service",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "AUDIT_SERVICE", "service": "giro-audit-service" },
    { "binding": "USER_SERVICE", "service": "giro-user-service" }
  ],
  "observability": { "enabled": true }
}
