generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String            @id
  name              String
  slug              String
  logo_url          String?
  status            String
  subscription_plan String
  clients           Client[]
  histories         ClientHistory[]
  pendingHistories  ClientHistoryPending[]
  pas               PA[]
  terminations      ClientTermination[]
  tasks             Task[]
  clientRegimes     ClientRegime[]
  clientSegments    ClientSegment[]
  groups            Group[]
  groupMembers      ClientsGroup[]
  licitacaoHistory  ClientLicitacaoHistory[]

  @@map("organizations")
}

model Client {
  id                            String       @id @default(uuid())
  dominio_code                  String?
  name                          String
  company_name                  String?
  fantasy_name                  String?
  cnae                          String?
  responsible                   String?
  cpf_responsible               String?
  agent                         String?
  cpf_agent                     String?
  number                        String?
  email                         String?
  address                       String?
  cep                           String?
  neighborhood                  String?
  state                         String?
  city                          String?
  customer_since                DateTime?
  municipal_registration        String?
  state_registration            String?
  commercial_board_registration String?
  status                        String
  competence_entry              DateTime?
  competence_output             DateTime?
  opening_date                  DateTime?
  instagram                     String?
  indication                    String?
  regime                        String?
  size                          String?
  segment                       String?
  coringa_status                String?
  tecnologia                    Boolean?
  licitacao                     Boolean?
  start_strike                  DateTime?
  end_strike                    DateTime?
  deletion_date                 DateTime?
  contract                      Boolean?
  prospecting_status            String
  date_status                   DateTime?
  description_prospecting       String?
  participants_meet             String?
  meet_type                     String?
  closing_date                  DateTime?
  register_date_prospecting     DateTime @default(now())
  contabil                      Boolean?
  fiscal                        Boolean?
  pessoal                       Boolean?
  infoproduto                   Boolean?
  consultoria                   Boolean?
  castelo_med                   Boolean?
  cnae_secondary                String?
  service_unique                Boolean?
  cpf_cnpj                      String       @default("")
  type                          String       @default("PJ")
  type_registration             String       @default("Novo")
  organization_id               String
  organization                  Organization @relation(fields: [organization_id], references: [id])
  histories                     ClientHistory[]
  pendingHistories              ClientHistoryPending[]
  pa                            PA?
  terminations                  ClientTermination[]
  tasks                         Task[]
  groups                        ClientsGroup[]
  licitacaoHistory              ClientLicitacaoHistory[]

  @@map("clients")
}

model Department {
  id    String @id
  name  String
  users User[]

  @@map("departments")
}

model User {
  id               String                  @id
  name             String
  department_id    String
  department       Department              @relation(fields: [department_id], references: [id])
  histories        ClientHistory[]
  pendingHistories ClientHistoryPending[]

  @@map("users")
}

model PA {
  client_id                 String       @id
  activities                String?
  tax_billing               String?
  management_billing        String?
  works_bidding             Boolean?
  dissatisfaction           String?
  registered_collabortors   Int?
  unregistered_collabortors Int?
  esocial                   Boolean?
  how_many_banks             Boolean?
  whitch_banks               String?
  responsible_departments    String?
  works_system               Boolean?
  system_name                String?
  system_usage_time          String?
  system_value               String?
  system_contact             String?
  system_operations          String?
  cloud_storage              Boolean?
  which_cloud_storage        String?
  rental_agreement           Boolean?
  assessment_regime          String?
  permit                     String?
  services                   String?
  organization_id            String
  client                     Client       @relation(fields: [client_id], references: [id])
  organization               Organization @relation(fields: [organization_id], references: [id])

  @@map("clients.pa")
}

model ClientHistory {
  id              String       @id @default(uuid())
  client_id       String
  date            DateTime
  history         String
  file            String?
  user_id         String
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("clients.history")
}

model ClientHistoryPending {
  id              String       @id @default(uuid())
  user_id         String
  client_id       String
  reason          String
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("clients.historyPending")
}

model ClientTermination {
  id              String       @id @default(uuid())
  client_id       String
  reason          String
  description     String
  competence      String
  date            DateTime     @default(now())
  user_id         String
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("clients.termination")
}

model Task {
  id              String       @id @default(uuid())
  client_id       String
  status          String
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("integracao.tasks")
}

model ClientCommercialProjectionEvent {
  id                   String   @id
  organization_id      String
  client_id            String
  event_type           String
  audit_correlation_id String
  applied_at           DateTime @default(now())
  created_at           DateTime @default(now())

  @@index([organization_id, client_id, applied_at], map: "idx_client_commercial_projection_client")
  @@map("client.commercial_projection_events")
}

model ClientRegime {
  id              String       @id @default(uuid())
  name            String
  normalized_name String
  organization_id String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, normalized_name], map: "uq_client_regime_org_normalized_name")
  @@map("clients.regimes")
}

model ClientSegment {
  id              String       @id @default(uuid())
  name            String
  normalized_name String
  type            String
  organization_id String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, normalized_name], map: "uq_client_segment_org_normalized_name")
  @@map("clients.segments")
}

model Group {
  id              String         @id @default(uuid())
  name            String
  status          Boolean        @default(true)
  organization_id String
  clients         ClientsGroup[]
  organization    Organization   @relation(fields: [organization_id], references: [id])

  @@map("clients.group")
}

model ClientsGroup {
  id              String       @id @default(uuid())
  group_id        String
  client_id       String
  organization_id String
  client          Client       @relation(fields: [client_id], references: [id])
  group           Group        @relation(fields: [group_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([group_id, client_id], map: "uq_clients_group_member")
  @@map("clients.clientsGroup")
}

model ClientLicitacaoHistory {
  id              String       @id @default(uuid())
  organization_id String
  client_id       String
  previous_value  Boolean?
  new_value       Boolean?
  actor_user_id   String
  created_at      DateTime     @default(now())
  client          Client       @relation(fields: [client_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@index([organization_id, client_id, created_at], map: "idx_client_licitacao_history_client")
  @@map("clients.licitacao_history")
}
