generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuditRequest {
  id              String   @id @default(uuid())
  organization_id String?
  user_id         String?
  created_at      DateTime @default(now())
  action          String?
  referring       String?
  referring_id    String?
  changes_json    Json?

  @@map("audit_requests")
}

model PessoalGroup {
  id              String   @id @default(uuid())
  name            String
  normalized_name String
  policy          String   @default("NORMAL")
  system_key      String?
  archived_at     DateTime?
  organization_id String
  payrolls        Payroll[]
  assignmentPreviews PessoalGroupAssignmentPreview[]

  @@unique([organization_id, normalized_name], map: "uq_pessoal_group_org_normalized_name")
  @@unique([organization_id, system_key], map: "uq_pessoal_group_org_system_key")
  @@index([organization_id, archived_at, name], map: "idx_pessoal_group_org_archived_name")

  @@map("pessoal.group")
}

model UnionPessoal {
  id              String   @id @default(uuid())
  name            String
  cnpj            String
  base_date       DateTime?
  organization_id String
  payrolls        Payroll[]

  @@map("pessoal.union")
}

model Payroll {
  id              String   @id @default(uuid())
  client_id       String   @unique
  responsible_id  String?
  advance         Boolean
  advance_type    String?
  advance_amount  Float?
  info            String
  previous        Boolean
  onvio           Boolean
  group_id        String
  vt              Boolean
  vt_value        Float?
  vt_type         String?
  va              Boolean
  assistance_fee  Boolean
  union_id        String?
  bem_mais        Boolean
  bsf             Boolean
  reinf           Boolean
  employees       Int
  contact         String?
  organization_id String
  group           PessoalGroup @relation(fields: [group_id], references: [id], onDelete: Restrict)
  responsible     User?         @relation(fields: [responsible_id], references: [id])
  union           UnionPessoal? @relation(fields: [union_id], references: [id], onDelete: Restrict)
  // Ausente no canônico (lá o select de client_name falha): o extract seleciona client.name.
  client          Client?       @relation(fields: [client_id], references: [id])
  groupAssignmentPreviewDetails PessoalGroupAssignmentPreviewDetail[]

  @@map("pessoal.payroll")
}

model Client {
  id              String @id @default(uuid())
  name            String
  status          String
  pessoal         Boolean
  organization_id String
  payroll         Payroll?
  obrigationsPessoal ObrigationsPessoal[]

  @@map("clients")
}

model LddPessoal {
  id                  String   @id @default(uuid())
  client_id           String
  type                String
  period              String?
  due_date            DateTime?
  balance_amount      Float?
  registration_status String?
  status              String?
  organization_id     String

  @@map("pessoal.ldd")
}

model User {
  id              String  @id @default(uuid())
  name            String
  full_name       String?
  organization_id String?
  status          String
  permissions     Permission[]
  payroll         Payroll[]
  obrigationsPessoal ObrigationsPessoal[]

  @@map("users")
}

model Permission {
  id              String @id @default(uuid())
  user_id         String
  pessoal         Int    @default(0)
  organization_id String
  user            User   @relation(fields: [user_id], references: [id])

  @@unique([user_id, organization_id], map: "uq_permissions_user_org")
  @@map("permissions")
}

model PasswordPessoal {
  id              String   @id @default(uuid())
  client_id       String
  service_name    String
  login_main      String?
  senha_main      String?
  login_secondary String?
  senha_secondary String?
  responsavel_id  String?
  notes           String?
  organization_id String

  @@map("pessoal.passwords")
}

model ObrigationsPessoal {
  id                    String   @id @default(uuid())
  client_id             String
  competence            String
  responsavel_id        String?
  advance               Boolean?
  payroll               Boolean?
  charges               Boolean?
  assistance_fee        Boolean?
  bem_mais              Boolean?
  bsf                   Boolean?
  va                    Boolean?
  vt                    Boolean?
  group_snapshot_id     String?
  group_snapshot_name   String?
  group_snapshot_policy String?
  organization_id       String
  client                Client       @relation(fields: [client_id], references: [id])
  responsible           User?        @relation(fields: [responsavel_id], references: [id])

  @@unique([organization_id, client_id, competence], map: "uq_pessoal_obligations_org_client_competence")
  @@index([organization_id, competence], map: "idx_pessoal_obligations_org_competence")
  @@map("pessoal.obrigations")
}

model SituationsPessoal {
  id                String   @id @default(uuid())
  client_id         String
  status            String
  title             String
  description       String
  registration_date DateTime @default(now())
  completion_date   DateTime?
  registered_by_id  String
  completed_by_id   String?
  organization_id   String

  @@map("pessoal.situations")
}

model PessoalGroupAssignmentPreview {
  id              String   @id @default(uuid())
  organization_id String
  target_group_id String
  fingerprint     String
  version         Int      @default(1)
  totals          Json
  expires_at      DateTime
  applied_at      DateTime?
  created_by_id   String
  created_at      DateTime @default(now())
  targetGroup     PessoalGroup @relation(fields: [target_group_id], references: [id], onDelete: Restrict)
  details         PessoalGroupAssignmentPreviewDetail[]
  confirmations   PessoalGroupAssignmentConfirmation[]
  auditOutboxEvents PessoalAuditOutboxEvent[]

  @@index([organization_id, expires_at], map: "idx_pessoal_group_assignment_preview_org_expiry")
  @@map("pessoal.group_assignment_previews")
}

model PessoalGroupAssignmentPreviewDetail {
  id                  String   @id @default(uuid())
  preview_id          String
  client_id           String
  client_name         String?
  payroll_id          String?
  previous_group_id   String?
  previous_group_name String?
  outcome             String
  skip_reason         String?
  preview             PessoalGroupAssignmentPreview @relation(fields: [preview_id], references: [id], onDelete: Cascade)
  payroll             Payroll? @relation(fields: [payroll_id], references: [id], onDelete: SetNull)

  @@unique([preview_id, client_id], map: "uq_pessoal_group_assignment_preview_client")
  @@index([preview_id, outcome, id], map: "idx_pessoal_group_assignment_detail_preview_outcome")
  @@map("pessoal.group_assignment_preview_details")
}

model PessoalGroupAssignmentConfirmation {
  id                String   @id @default(uuid())
  organization_id   String
  preview_id        String
  idempotency_key   String
  command_hash      String
  response_snapshot Json
  created_at        DateTime @default(now())
  preview           PessoalGroupAssignmentPreview @relation(fields: [preview_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, idempotency_key], map: "uq_pessoal_group_assignment_confirmation_org_idempotency_key")
  @@index([preview_id], map: "idx_pessoal_group_assignment_confirmation_preview")
  @@map("pessoal.group_assignment_confirmations")
}

model PessoalAuditOutboxEvent {
  id              String   @id @default(uuid())
  organization_id String
  preview_id      String
  payload         Json
  status          String   @default("pending")
  created_at      DateTime @default(now())
  processed_at    DateTime?
  preview         PessoalGroupAssignmentPreview @relation(fields: [preview_id], references: [id], onDelete: Cascade)

  @@index([status, created_at], map: "idx_pessoal_audit_outbox_dispatch")
  @@index([organization_id, preview_id], map: "idx_pessoal_audit_outbox_preview")
  @@map("pessoal.audit_outbox_events")
}

model PessoalNotification {
  id              String   @id @default(uuid())
  user_id         String
  regarding_id    String
  title           String
  message         String
  reference_date  DateTime @default(now())
  create_at       DateTime @default(now())
  read            Boolean  @default(false)
  regarding       String
  organization_id String

  @@unique([organization_id, user_id, regarding, regarding_id, title, reference_date], map: "uq_pessoal_notification_identity")
  @@map("notification.pessoal")
}
