generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PessoalGroup {
  id              String   @id @default(uuid())
  name            String
  normalized_name String
  policy          String   @default("NORMAL")
  system_key      String?
  archived_at     DateTime?
  organization_id String

  @@map("pessoal.group")
}

model UnionPessoal {
  id              String   @id @default(uuid())
  name            String
  cnpj            String
  base_date       DateTime?
  organization_id String

  @@map("pessoal.union")
}

model Payroll {
  id              String   @id @default(uuid())
  client_id       String   @unique
  responsible_id  String?
  advance         Boolean
  advance_type    String?
  advance_amount  Float?
  info            String
  previous        Boolean
  onvio           Boolean
  group_id        String
  vt              Boolean
  vt_value        Float?
  vt_type         String?
  va              Boolean
  assistance_fee  Boolean
  union_id        String?
  bem_mais        Boolean
  bsf             Boolean
  reinf           Boolean
  employees       Int
  contact         String?
  organization_id String

  @@map("pessoal.payroll")
}

model Client {
  id              String @id @default(uuid())
  organization_id String

  @@map("clients")
}

model LddPessoal {
  id                  String   @id @default(uuid())
  client_id           String
  type                String
  period              String?
  due_date            DateTime?
  balance_amount      Float?
  registration_status String?
  status              String?
  organization_id     String

  @@map("pessoal.ldd")
}

model User {
  id              String  @id @default(uuid())
  name            String
  full_name       String?
  organization_id String?

  @@map("users")
}

model PasswordPessoal {
  id              String   @id @default(uuid())
  client_id       String
  service_name    String
  login_main      String?
  senha_main      String?
  login_secondary String?
  senha_secondary String?
  responsavel_id  String?
  notes           String?
  organization_id String

  @@map("pessoal.passwords")
}

model SituationsPessoal {
  id                String   @id @default(uuid())
  client_id         String
  status            String
  title             String
  description       String
  registration_date DateTime @default(now())
  completion_date   DateTime?
  registered_by_id  String
  completed_by_id   String?
  organization_id   String

  @@map("pessoal.situations")
}
