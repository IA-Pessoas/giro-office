  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then((fs) => { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true }); })\" && tsc -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@launchdarkly/node-server-sdk": "^9.13.1",
    "@supabase/supabase-js": "^2.99.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  }
