      "default": "./dist/audit/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "import": "./dist/datetime/index.js",
      "default": "./dist/datetime/index.js"
    },
    "./featureFlags": {
      "types": "./dist/featureFlags/index.d.ts",
      "development": "./src/featureFlags/index.ts",
      "import": "./dist/featureFlags/index.js",
      "default": "./dist/featureFlags/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
