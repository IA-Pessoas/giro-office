# Banco de Dados
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"
DATABASE_POOL_MAX=1

# Autenticação
JWT_SECRET="your-32-character-secret-key-here"

# Criptografia (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MTK_ENCRYPTION_KEY=""

# E-mail (Gmail SMTP)
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# Frontend (same-origin via proxy)
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://gateway:3010

# Gateway
GATEWAY_PORT=3010
GATEWAY_ALLOWED_ORIGINS=https://useoffice.com.br
GATEWAY_PUBLIC_URL=http://localhost:3010
GATEWAY_JSON_BODY_LIMIT=1mb
AUTH_COOKIE_SECURE=true
GATEWAY_BEARER_AUTH_COMPATIBILITY=false
USER_SERVICE_URL=http://localhost:3030
DEPARTMENT_SERVICE_URL=http://localhost:3036
TASK_SERVICE_URL=http://localhost:3032
PROJECT_SERVICE_URL=http://localhost:3033
FISCAL_SERVICE_URL=http://localhost:3037
CONTABIL_SERVICE_URL=http://localhost:3038
REGULARIZE_SERVICE_URL=http://localhost:3039
TI_SERVICE_URL=http://localhost:3040
PESSOAL_SERVICE_URL=http://localhost:3042
# WEBSOCKET_UPSTREAM_URL=http://localhost:3030

# Audit Service (porta 3020)
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_PORT=3020
AUDIT_SERVICE_TOKEN=audit-service-token

SUPABASE_URL=https://seu-projeto.supabase.co
# uso exclusivo do backend/servico; nunca exponha a service role em cliente ou codigo frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-somente-no-backend>
# bucket do Supabase Storage para anexos de TI; crie-o como privado no painel do Supabase.
TI_REQUEST_IMAGE_BUCKET=ti-request-attachments-private
# Microservices
ORGANIZATION_SERVICE_URL=http://localhost:3031
RH_SERVICE_URL=http://localhost:3034
CLIENT_SERVICE_URL=http://localhost:3035
CLIENT_SERVICE_INTERNAL_TOKEN=defina-um-token-interno
TI_SERVICE_INTERNAL_TOKEN=defina-um-token-interno-ti
# Opcional: se vazio, usa o mesmo valor que AUDIT_SERVICE_TOKEN
# INTERNAL_SERVICE_TOKEN=
REGULARIZE_SERVICE_BASE_URL=http://localhost:3039
EDGE_FUNCTION_SECRET=defina-um-token-para-funcoes-edge

# Certificate Service: a chave deve corresponder aos envelopes legados existentes.
CERTIFICATE_PASSWORD_ENCRYPTION_KEY=<base64 de 32 bytes; deve corresponder aos envelopes legados>
CERTIFICATE_PASSWORD_ENCRYPTION_KEY_VERSION=v1
