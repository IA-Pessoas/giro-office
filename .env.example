# Banco de Dados
DATABASE_URL="postgresql://user:password@host:5432/database"

# Autenticação
JWT_SECRET="your-32-character-secret-key-here"

# Criptografia (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MTK_ENCRYPTION_KEY=""

# E-mail (Gmail SMTP)
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# Frontend (Next.js - precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL="http://localhost:3334"

# Gateway
GATEWAY_PORT=3334
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
USER_SERVICE_URL=http://localhost:3335
TASK_SERVICE_URL=http://localhost:3337
PROJECT_SERVICE_URL=http://localhost:3338
REGULARIZE_SERVICE_URL=http://localhost:3411
# Opcional: WebSocket /socket.io (ex.: mesmo host do user-service)
# WEBSOCKET_UPSTREAM_URL=http://localhost:3335

# Audit Service (porta 3336)
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://localhost:3336
AUDIT_SERVICE_PORT=3336
AUDIT_SERVICE_TOKEN=audit-service-token

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...  (sua secret key)
# Microservices
ORGANIZATION_SERVICE_URL=http://localhost:3400
CLIENT_SERVICE_URL=http://localhost:3410
CLIENT_SERVICE_INTERNAL_TOKEN=defina-um-token-interno
RH_SERVICE_URL=http://localhost:3339
REGULARIZE_SERVICE_INTERNAL_TOKEN=defina-um-token-interno
