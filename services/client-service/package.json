{
  "name": "@workspace/client-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "node ../../scripts/prisma-generate.mjs",
    "prebuild": "node ../../scripts/prisma-generate.mjs",
    "predev": "node ../../scripts/prisma-generate.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "node ../../scripts/prisma-generate.mjs && tsc --noEmit",
    "prestart": "pnpm build",
    "start": "node dist/server.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "7.4.1",
    "@supabase/supabase-js": "^2.99.1",
    "@workspace/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "prisma": "7.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.2",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vite": "7.3.5",
    "vitest": "^4.1.9"
  }
}
