PORT=3035
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/database"
JWT_SECRET="your-32-character-secret-key-here"
LOG_LEVEL=info
LOG_PRETTY=false
ENABLE_API_DOCS=true
CLIENT_HISTORY_STORAGE_DIR=.data/client-history-uploads
CLIENT_SERVICE_INTERNAL_TOKEN=
# Provider oficial de CNPJ; sem ambos, a UI mantém o preenchimento manual.
CNPJ_LOOKUP_API_URL=
CNPJ_LOOKUP_API_TOKEN=
# Trilha exigida da troca de Instagram; fora de produção também é fallback do token interno.
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token
