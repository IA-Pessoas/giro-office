{
  "name": "@workspace/regularize-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "node ../../scripts/prisma-generate.mjs",
    "prebuild": "pnpm prisma:generate",
    "predev": "pnpm prisma:generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/assets', { recursive: true }); fs.copyFileSync('src/assets/Regularize.png', 'dist/assets/Regularize.png');\"",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "check": "biome check .",
    "start": "node dist/server.js",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@workspace/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.13.0",
    "pdfkit": "0.19.1",
    "prisma": "7.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.3.0",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  }
}
