{
  "name": "@workspace/task-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "sync:prisma": "node -e \"const fs=require('fs'); const p='src/generated'; fs.existsSync(p)&&fs.rmSync(p,{recursive:true}); fs.cpSync('../src/src/generated', p, {recursive:true});\"",
    "prebuild": "pnpm sync:prisma",
    "predev": "pnpm sync:prisma",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "7.4.1",
    "@workspace/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.13.0",
    "prisma": "7.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
