# Task Service (porta 3032)
# ENABLE_API_DOCS=true|false — /docs e /openapi.json (padrão: true se NODE_ENV≠production)
PORT=3032

# Banco de Dados (obrigatório)
DATABASE_URL=postgresql://user:password@host:5432/database

# Autenticação (obrigatório para validação JWT direta)
JWT_SECRET=your-32-character-secret-key-here


# Audit Service
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token

# Extracao de tarefas por IA (wizard de Projetos)
# AI_EXTRACTION_MODE=fake (padrao) usa o adapter deterministico local, sem rede nem creditos.
# AI_EXTRACTION_MODE=openai exige OPENAI_API_KEY. Producao exige openai; fake e rejeitado no boot.
AI_EXTRACTION_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_EXTRACTION_TIMEOUT_MS=30000
AI_EXTRACTION_RATE_LIMIT_MAX=10
AI_EXTRACTION_RATE_LIMIT_WINDOW_MS=60000

# Log
LOG_LEVEL=info
LOG_PRETTY=false
