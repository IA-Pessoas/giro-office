# Task Service (porta 3032)
# ENABLE_API_DOCS=true|false — /docs e /openapi.json (padrão: true se NODE_ENV≠production)
PORT=3032

# Banco de Dados (obrigatório)
DATABASE_URL=postgresql://user:password@host:5432/database

# Autenticação (obrigatório para validação JWT direta)
JWT_SECRET=your-32-character-secret-key-here


# Audit Service
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token

# Log
LOG_LEVEL=info
LOG_PRETTY=false
