NODE_ENV=development
MARKETING_SERVICE_PORT=3047
DATABASE_URL=postgresql://localhost/marketing_service
JWT_SECRET=
MARKETING_SERVICE_INTERNAL_TOKEN=
MTK_ENCRYPTION_KEY=
# Trilha exigida: sem auditoria, as alterações respondem 503 e não são salvas.
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token
SERVICE_ALLOWED_ORIGINS=*
ENABLE_API_DOCS=true
LOG_LEVEL=info
LOG_PRETTY=true
