# Autenticação (obrigatório)
JWT_SECRET="your-32-character-secret-key-here"

# Gateway
GATEWAY_PORT=3010
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
USER_SERVICE_URL=http://localhost:3030
TASK_SERVICE_URL=http://localhost:3032
PROJECT_SERVICE_URL=http://localhost:3033
# Opcional: HTTP(S) do serviço que atende upgrade WebSocket em /socket.io
# WEBSOCKET_UPSTREAM_URL=http://localhost:3030

# Microservices
ORGANIZATION_SERVICE_URL=http://localhost:3031
RH_SERVICE_URL=http://localhost:3034
# Log
LOG_LEVEL=info
LOG_PRETTY=false

# Audit Service
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token
