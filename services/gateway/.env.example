# Autenticação (obrigatório)
JWT_SECRET="your-32-character-secret-key-here"

# Gateway
GATEWAY_PORT=3334
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
USER_SERVICE_URL=http://localhost:3335
# Opcional: HTTP(S) do serviço que atende upgrade WebSocket em /socket.io
# WEBSOCKET_UPSTREAM_URL=http://localhost:3335

# Microservices
ORGANIZATION_SERVICE_URL=http://localhost:3400
RH_SERVICE_URL=http://localhost:3339
# Log
LOG_LEVEL=info
LOG_PRETTY=false

# Audit Service
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://localhost:3336
AUDIT_SERVICE_TOKEN=audit-service-token