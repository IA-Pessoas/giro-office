# Autenticação (obrigatório)
JWT_SECRET="your-32-character-secret-key-here"

# Gateway
GATEWAY_PORT=3010
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:3010
# Feature flags: disabled by default; SDK key is server-side only.
# FEATURE_FLAGS_ENABLED=true
# LAUNCHDARKLY_SDK_KEY=
# LAUNCHDARKLY_INIT_TIMEOUT_MS=3000
# Em produção, a documentação fica desabilitada por padrão. Habilite apenas sob demanda.
# ENABLE_API_DOCS=true
# Valor seguro padrão: enforce. Use observe temporariamente durante o rollout.
# GATEWAY_AUTHORIZATION_MODE=observe
USER_SERVICE_URL=http://localhost:3030
DEPARTMENT_SERVICE_URL=http://localhost:3036
TASK_SERVICE_URL=http://localhost:3032
PROJECT_SERVICE_URL=http://localhost:3033
# Opcional: HTTP(S) do serviço que atende upgrade WebSocket em /socket.io
# WEBSOCKET_UPSTREAM_URL=http://localhost:3030

# Microservices (mounted paths on gateway: /organizations, /client, /rh)
ORGANIZATION_SERVICE_URL=http://localhost:3031
RH_SERVICE_URL=http://localhost:3034
CLIENT_SERVICE_URL=http://localhost:3035
# Deve ser igual ao CLIENT_SERVICE_INTERNAL_TOKEN do client-service.
CLIENT_SERVICE_INTERNAL_TOKEN=
FISCAL_SERVICE_URL=http://localhost:3037
CONTABIL_SERVICE_URL=http://localhost:3038
REGULARIZE_SERVICE_URL=http://localhost:3039
REGULARIZE_SERVICE_INTERNAL_TOKEN=defina-um-token-exclusivo-para-o-regularize
PESSOAL_SERVICE_URL=http://localhost:3042
# Log
LOG_LEVEL=info
LOG_PRETTY=false

# Audit Service (gateway proxies /audit when AUDIT_ENABLED=true; must match audit-service token)
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token
