# Servidor
# ENABLE_API_DOCS=true|false — /docs e /openapi.json (padrão: true se NODE_ENV≠production)
PORT=3030
NODE_ENV=development

# Banco de Dados
DATABASE_URL=postgresql://user:password@host:5432/database

# Autenticação
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_PASSWORD=your-admin-password
# Mesmo valor que AUDIT_SERVICE_TOKEN no gateway (pedidos encaminhados com x-internal-service-token)
AUDIT_SERVICE_TOKEN=audit-service-token

# Supabase (obrigatório — fotos de utilizador só em Storage + URL pública)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
