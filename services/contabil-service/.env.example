# Obrigatórias — copie para .env e preencha (não commite .env)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco
JWT_SECRET=mesmo_segredo_usado_no_gateway_user_service_para_validar_jwt

# Opcionais
PORT=3038
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false

# Auditoria (HTTP para o audit-service)
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token

# Resumo interno da Triagem (opcional; indisponibilidade degrada o mensal local)
TRIAGEM_SERVICE_URL=http://localhost:3046
TRIAGEM_INTERNAL_TOKEN=triagem-internal-token
TRIAGEM_REQUEST_TIMEOUT_MS=2000
