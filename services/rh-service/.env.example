# Porta HTTP do rh-service (default 3339)
PORT=3339

# Mesma URL do Postgres usada pelos outros serviços (ex.: Supabase)
DATABASE_URL=

# Mesmo segredo JWT do user-service / gateway
JWT_SECRET=01234567890123456789012345678901

# Opcional: development | production
NODE_ENV=development

# Nível de log (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# true para logs legíveis no terminal (desativado em production)
LOG_PRETTY=false
