# Porta HTTP do rh-service (default 3034)
# ENABLE_API_DOCS=true|false — /docs e /openapi.json (padrão: true se NODE_ENV≠production)
PORT=3034

# Mesma URL do Postgres usada pelos outros serviços (ex.: Supabase)
DATABASE_URL=

# Limite maximo de conexoes do pool PrismaPg (default: 1)
DATABASE_POOL_MAX=1

# Mesmo segredo JWT do user-service / gateway
JWT_SECRET=01234567890123456789012345678901

# Token e segredo compartilhados com o reports-service para extração interna segura.
REPORTS_INTERNAL_TOKEN=defina-um-token-interno
REPORTS_GRANT_SECRET=defina-um-segredo-de-grant

# Opcional: development | production
NODE_ENV=development

# Nível de log (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# true para logs legíveis no terminal (desativado em production)
LOG_PRETTY=false

# Intervalo mínimo em minutos entre batidas de ponto no mesmo dia (default 1)
POINT_MIN_INTERVAL_MINUTES=30
