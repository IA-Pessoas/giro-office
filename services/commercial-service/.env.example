COMMERCIAL_SERVICE_PORT=3045
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/giro
JWT_SECRET=change-me
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token
CLIENT_SERVICE_URL=http://localhost:3035
# This must match CLIENT_SERVICE_INTERNAL_TOKEN in client-service.
CLIENT_SERVICE_INTERNAL_TOKEN=audit-service-token
TASK_SERVICE_URL=http://localhost:3032
# Match the internal token accepted by task-service.
TASK_SERVICE_INTERNAL_TOKEN=audit-service-token
COMMERCIAL_EMAIL_FROM=no-reply@girooffice.local
COMMERCIAL_EMAIL_ADAPTER_TIMEOUT_MS=10000
COMMERCIAL_OUTBOX_WORKER_POLL_INTERVAL_MS=1000
COMMERCIAL_OUTBOX_WORKER_MAX_ATTEMPTS=5
COMMERCIAL_OUTBOX_WORKER_RETRY_BASE_MS=1000
ENABLE_API_DOCS=true
SERVICE_ALLOWED_ORIGINS=http://localhost:3000

# In production, configure both values and use an HTTPS adapter URL.
# COMMERCIAL_EMAIL_ADAPTER_URL=https://email-adapter.example.test
# COMMERCIAL_EMAIL_ADAPTER_TOKEN=change-me
