## department-service
## Copie para `.env` e ajuste os valores para o seu ambiente.

# Porta do serviço (padrão: 3341)
DEPARTMENT_SERVICE_PORT=3036

# Obrigatórias (exemplo Postgres local)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/castelo
JWT_SECRET=change-me

# Ambiente
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Auditoria
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3336
AUDIT_SERVICE_TOKEN=audit-service-token

# Documentação (se vazio/undefined, habilita fora de produção)
# ENABLE_API_DOCS=true
