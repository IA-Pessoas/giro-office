NODE_ENV=development
PORT=3041
DATABASE_URL=postgresql://user:password@localhost:5432/workspace_dev?schema=public
JWT_SECRET=replace-with-a-local-jwt-secret
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=replace-with-a-local-audit-service-token
CERTIFICATE_SERVICE_INTERNAL_TOKEN=replace-with-a-local-internal-service-token
CERTIFICATE_NOTIFICATION_WINDOW_DAYS=30
SERVICE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010
ENABLE_API_DOCS=true
LOG_LEVEL=debug
LOG_PRETTY=true

# Certificate file storage
# Supabase is the recommended/default provider for dev integration, staging, VPS and production.
# Use CERTIFICATE_STORAGE_MODE=local only for unit tests or offline local execution.
# When CERTIFICATE_STORAGE_MODE=supabase, configure SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
CERTIFICATE_STORAGE_MODE=supabase
CERTIFICATE_STORAGE_BUCKET=Certificados
CERTIFICATE_STORAGE_DIR=.data/certificate-files
CERTIFICATE_FILE_MAX_SIZE_BYTES=5242880
CERTIFICATE_FILE_ENCRYPTION_KEY=base64-32-byte-key-goes-here
CERTIFICATE_FILE_ENCRYPTION_KEY_VERSION=v1
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
