# Obrigatórias — copie para .env e preencha (não commite .env)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco
JWT_SECRET=mesmo_segredo_usado_no_gateway_user_service_para_validar_jwt

# Opcionais
# ENABLE_API_DOCS=true|false — documentação em /docs e /openapi.json (padrão: true se NODE_ENV≠production)
PORT=3037
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false

# Auditoria (HTTP para o audit-service)
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://localhost:3020
AUDIT_SERVICE_TOKEN=audit-service-token

# Reporting interno (compartilhe com o reports-service; não commite valores reais)
REPORTS_INTERNAL_TOKEN=reports-service-token
REPORTS_GRANT_SECRET=reports-grant-secret

# Anexos das malhas (bucket privado no Supabase Storage; sem estas variáveis o anexo responde 503)
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# FISCAL_MALHA_ATTACHMENT_BUCKET=fiscal-malha-attachments
