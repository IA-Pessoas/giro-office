{
  "name": "@workspace/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit && pnpm run typecheck:usefetch",
    "test:auth": "node --experimental-strip-types --experimental-specifier-resolution=node src/modules/auth/run-auth-tests.mjs",
    "test:clients": "node --experimental-strip-types src/modules/clients/run-clients-tests.mjs",
    "test:contabil": "node --experimental-strip-types src/modules/contabil/run-contabil-tests.mjs",
    "test:projects": "node --experimental-strip-types src/modules/integracao/run-project-tests.mjs",
    "test:chat-context": "node --experimental-strip-types src/modules/chat/run-chat-context-tests.mjs",
    "test:chat-window": "node --experimental-strip-types src/modules/chat/run-conversation-window-tests.mjs",
    "test:chat": "pnpm run test:chat-context && pnpm run test:chat-window",
    "test:iframe": "node --experimental-strip-types src/components/Iframe/run-details-tests.mjs",
    "test:certificates": "node --experimental-strip-types src/modules/certificates/run-certificate-tests.mjs",
    "test:a11y-overlays": "node --experimental-strip-types src/shared/components/run-a11y-overlays-tests.mjs",
    "test:status-badge": "node --experimental-strip-types src/shared/components/run-status-badge-tests.mjs",
    "test": "pnpm run test:auth && pnpm run test:clients && pnpm run test:contabil && pnpm run test:projects && pnpm run test:chat && pnpm run test:iframe && pnpm run test:certificates && pnpm run test:a11y-overlays && pnpm run test:status-badge",
    "start": "next start",
    "migration:audit:chakra": "node scripts/audit-chakra-usage.mjs",
    "migration:validate:criteria": "node scripts/validate-acceptance-criteria.mjs",
    "migration:baseline:visual": "node scripts/generate-visual-baseline.mjs",
    "lint": "echo \"Skipping app lint (Biome ignored for now)\"",
    "format": "echo \"Skipping app format (Biome ignored for now)\"",
    "check": "echo \"Skipping app check (Biome ignored for now)\"",
    "typecheck:usefetch": "tsc -p tsconfig.usefetch-types.json --noEmit"
  },
  "dependencies": {
