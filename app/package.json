    "icons": "^1.0.0",
    "js-cookie": "^3.0.7",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.487.0",
    "next": "^16.2.6",
    "nookies": "^2.5.2",
    "react": "^18.2.0",
    "react-dom": "^18",
