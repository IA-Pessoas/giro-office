    "test:status-badge": "node --experimental-strip-types src/shared/components/run-status-badge-tests.mjs",
    "test:image-optimization": "node src/shared/run-image-optimization-tests.mjs",
    "test:regularize": "node --experimental-strip-types src/modules/regularize/run-regularize-tests.mjs",
    "test:parcelamento": "node --experimental-strip-types src/modules/parcelamento/run-parcelamento-tests.mjs",
    "test:fiscal": "node --experimental-strip-types src/modules/fiscal/run-fiscal-tests.mjs",
    "test:commercial": "node src/modules/commercial/run-commercial-tests.mjs",
    "test:ti": "node --experimental-strip-types src/modules/ti/run-ti-tests.mjs",
