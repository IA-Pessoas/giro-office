    "test:users": "node --experimental-strip-types src/modules/users/run-users-tests.mjs",
    "test:clients": "node --experimental-strip-types src/modules/clients/run-clients-tests.mjs",
    "test:departments": "node --experimental-strip-types src/modules/departments/run-departments-tests.mjs",
    "test:contabil": "node --experimental-strip-types src/modules/contabil/run-contabil-tests.mjs",
