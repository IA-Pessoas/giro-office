# API (Next.js - precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL="/api"
# Feature flags: use only the LaunchDarkly client-side ID in the browser bundle.
# NEXT_PUBLIC_FEATURE_FLAGS_ENABLED=true
# NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_ID=
# NEXT_PUBLIC_LAUNCHDARKLY_INIT_TIMEOUT_MS=3000
# Assistente IA da barra superior (ainda sem backend de IA). Fica oculto sem "true"; ligar só em
# ambientes de teste. Valor lido no build.
# NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true
# Opcional: use "false" apenas em slots HTTP; vazio preserva o default seguro.
NEXT_PUBLIC_AUTH_COOKIE_SECURE=""
# SSR / rewrites em next.config.mjs (destino do proxy /api/* no servidor Next)
API_INTERNAL_URL="http://gateway:3010"
