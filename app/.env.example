# API (Next.js - precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL="/api"
# Opcional: use "false" apenas em slots HTTP; vazio preserva o default seguro.
NEXT_PUBLIC_AUTH_COOKIE_SECURE=""
# SSR / rewrites em next.config.mjs (destino do proxy /api/* no servidor Next)
API_INTERNAL_URL="http://gateway:3010"
