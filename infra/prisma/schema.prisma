model ClientPF {
  id                   String       @id @default(uuid())
  code                 String
  name                 String
  sex                  String
  address              String
  city                 String
  zip_code             String
  state                String
  profession           String
  father               String
  mother               String
  marital_status       String
  date_of_birth        DateTime
  cpf                  String
  rg                   String
  rg_expedition        DateTime?
  rg_validity          DateTime?
  military_certificate String
