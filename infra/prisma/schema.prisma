datasource db {
  provider = "postgresql"
}

model Organization {
  id                            String                        @id @default(uuid())
  name                          String
  slug                          String                        @unique
  created_at                    DateTime                      @default(now())
  updated_at                    DateTime                      @updatedAt
  cnpj                          String                        @unique
  email_created_by              String
  logo_url                      String?
  subscription_plan             String                        @default("trial")
  status                        status                        @default(active)
  agendas                       Agenda[]
  recurringAgendas              RecurringAgenda[]
  auditRequests                 AuditRequest[]
  budgets                       Budget[]
  certificatesPF                CertificatePF[]
  certificatesPJ                CertificatePJ[]
  chats                         Chat[]
  messages                      Message[]
  chatParticipants              ChatParticipant[]
  clientClouds                  ClientClouds[]
  clients                       Client[]
  clientsGroups                 ClientsGroup[]
  documentsTermination          DocumentClientTermination[]
  groups                        Group[]
  clientHistorys                ClientHistory[]
  clientHistorysPending         ClientHistoryPending[]
  pas                           PA[]
  clientsPF                     ClientPF[]
  clientTerminations            ClientTermination[]
  controlsContabil              ControlContabil[]
  relationshipsContabil         RelationshipContabil[]
  responsiblesContabil          ResponsibleContabil[]
  departments                   Department[]
  emails                        Emails[]
  icms                          Icms[]
  ipis                          Ipi[]
  ncms                          Ncm[]
  projectPlans                  ProjectPlan[]
  projectPlanTasks              ProjectPlanTasks[]
  projects                      Project[]
  tasks                         Task[]
  taskDependents                TaskDependent[]
  tasksIntegrationRegularize    TasksIntegrationRegularize[]
  taskModels                    TaskModel[]
  logs                          Logs[]
  passwordsMkt                  PasswordMkt[]
  notes                         Note[]
  certificateNotifications      CertificateNotification[]
  pessoalNotifications          PessoalNotification[]
  regularizeNotifications       RegularizeNotification[]
  organizationInvites           OrganizationInvite[]
  usersWithOrg                  User[]              @relation("UserOrganization")
  installments                  Installment[]
  installmentCompetencies       InstallmentCompetencies[]
  panoramasParcelamento         PanoramaParcelameto[]
  permissions                   Permission[]
  permissionsProjects           PermissionProject[]
  permissionsSpecifics          PermissionSpecific[]
  lddPessoal                    LddPessoal[]
  obrigationsPessoal            ObrigationsPessoal[]
  passwordsPessoal              PasswordPessoal[]
  payrolls                      Payroll[]
  situationsPessoal             SituationsPessoal[]
  unionsPessoal                 UnionPessoal[]
  proposalConfigs               ProposalConfig[]
  licenses                      License[]
  municipalTaxes                MunicipalTaxes[]
  partners                      Partners[]
  sitePasswordsRegularize       SitePasswordsRegularize[]
  passwordsRegularize           PasswordRegularize[]
  proceduralGuidances           ProceduralGuidance[]
  processes                     Process[]
  holidays                      Holidays[]
  pointsConfig                  PointsConfig[]
  points                        Point[]
  rhCategories                  RhCategory[]
  rhMessages                    RhMessage[]
  rhRequests                    RhRequest[]
  scoreQuarters                 ScoreQuarter[]
  scoreEvaluations              ScoreEvaluation[]
  scoreNitros                   ScoreNitro[]
  scoreQuestions                ScoreQuestion[]
  timeBankReleases              TimeBankReleases[]
  timeClockRequests             TimeClockRequest[]
  timeSheets                    TimeSheets[]
  stocks                        Stock[]
  categorysStock                CategoryStock[]
  entrysStock                   EntryStock[]
  exitsStock                    ExitStock[]
  locationsStock                LocationStock[]
  extensionsTecnologia          ExtensionsTecnologia[]
  inventoryTecnologia           InventoryTecnologia[]
  inventoryCategoriesTecnologia InventoryCategoryTecnologia[]
  inventoryLocationsTecnologia  InventoryLocationTecnologia[]
  passwordsTecnologia           PasswordTecnologia[]
  tiCategories                  TICategoryRequest[]
  tiMessages                    TIMessage[]
  tiRequests                    TIRequest[]
  termsTecnologia               TermTecnologia[]
  triageConfigs                 TriageConfig[]
  triageMonthlys                TriageMonthly[]
  triageResponsibles            TriageResponsible[]

  @@map("organizations")
}



model OrganizationInvite {
  id              String       @id @default(uuid())
  organization_id String
  email_user      String
  token           String
  expires_at      DateTime
  accepted_at     DateTime?
  role            enumType     @default(user)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("organization_invites")
}

model Department {
  id                        String            @id @default(uuid())
  name                      String
  color                     String
  status                    String
  solution                  Boolean?
  organization_id           String
  agenda_controls           Agenda[]          @relation("department_control")
  agenda_recurring_controls RecurringAgenda[] @relation("department_control")
  budgets                   Budget[]
  organization              Organization      @relation(fields: [organization_id], references: [id])
  tasks                     Task[]
  tasksModel                TaskModel[]
  stocks                    Stock[]
  categorysStock            CategoryStock[]
  locationsStock            LocationStock[]
  users                     User[]

  @@map("departments")
}

model User {
  id                          String                 @id @default(uuid())
  name                        String
  login                       String
  password                    String
  permission                  Int
  status                      String
  organization_id             String?
  type                        enumType?
  first_owner_flag            Boolean?               @default(false)
  permission_id               String?                @unique
  department_id               String
  invited_by                  String?
  joined_at                   DateTime?              @default(now())
  photo_url                   String?
  full_name                   String?
  gender                      String?
  birth_date                  DateTime?
  cpf                         String?                 @unique
  rg                          String?                 @unique
  address                     String?
  job_title                   String?
  email                       String?
  phone                       String?
  hire_date                   DateTime?
  termination_date            DateTime?
  allergies                   Json?
  emergency_contacts          Json?
  agenda2                     Agenda[]               @relation("participant2")
  agenda3                     Agenda[]               @relation("participant3")
  agenda                      Agenda[]               @relation("participant")
  agendaRecurring2            RecurringAgenda[]      @relation("participant2")
  agendaRecurring3            RecurringAgenda[]      @relation("participant3")
  agendaRecurring             RecurringAgenda[]      @relation("participant")
  auditRequests               AuditRequest[]
  sentMessages                Message[]
  chats                       ChatParticipant[]
  clientHistorys              ClientHistory[]
  clientHistorysPending       ClientHistoryPending[]
  personResponsible           ResponsibleContabil[]  @relation("person_responsible")
  postedByContabil            ResponsibleContabil[]  @relation("posted_by")
  sponso                      Project[]              @relation("sponsor")
  tasks2                      Task[]                 @relation("responsible2")
  tasks3                      Task[]                 @relation("responsible3")
  tasks                       Task[]                 @relation("responsible")
  tasksModel2                 TaskModel[]            @relation("responsible2")
  tasksModel3                 TaskModel[]            @relation("responsible3")
  tasksModel                  TaskModel[]            @relation("responsible")
  logs                        Logs[]
  notes                       Note[]
  organization                Organization?         @relation("UserOrganization", fields: [organization_id], references: [id])
  permissionRef               Permission?           @relation("UserPrimaryPermission", fields: [permission_id], references: [id])
  panoramasParcelameto        PanoramaParcelameto[]  @relation("responsavelPanorama")
  permissions                 Permission[]
  permissionsSpecifics        PermissionSpecific?
  obrigationsPessoal          ObrigationsPessoal[]
  passPessoal                 PasswordPessoal[]
  payroll                     Payroll[]
  completedSituationsPessoal  SituationsPessoal[]    @relation("completed_by")
  registeredSituationsPessoal SituationsPessoal[]    @relation("registered_by")
  licensesResp                License[]
  processResp1                Process[]              @relation("responsible1")
  processResp2                Process[]              @relation("responsible2")
  processResp3                Process[]              @relation("responsible3")
  pointConfig                 PointsConfig?
  points                      Point[]
  senderMsgRH                 RhMessage[]
  assignerRH                  RhRequest[]            @relation("RequestAssignee")
  requesterRH                 RhRequest[]            @relation("RequestOwner")
  scores                      ScoreQuarter[]
  scoresEvaluaion             ScoreEvaluation[]
  timeBankRealeasesAdded      TimeBankReleases[]     @relation("add")
  timeBankRealeases           TimeBankReleases[]     @relation("user")
  timeClockRequestApproved    TimeClockRequest[]     @relation("approver")
  timeClockRequest            TimeClockRequest[]     @relation("user")
  timeSheets                  TimeSheets[]
  entrys                      EntryStock[]
  approversExists             ExitStock[]            @relation("approver")
  operatorsExists             ExitStock[]            @relation("operator")
  requestsExits               ExitStock[]            @relation("requester")
  extensions                  ExtensionsTecnologia[]
  staffInventory              InventoryTecnologia[]  @relation("staff")
  myInventory                 InventoryTecnologia[]  @relation("user")
  passwords                   PasswordTecnologia[]
  senderMsgTI                 TIMessage[]
  assigneerRequestsTI         TIRequest[]            @relation("TiAssignee")
  requestsTI                  TIRequest[]            @relation("TiRequester")
  terms                       TermTecnologia[]
  triageMonthlys              TriageMonthly[]
  responsiblesTriage          TriageResponsible[]
  department                  Department             @relation(fields: [department_id], references: [id])

  @@map("users")
}

model Permission {
  id              String       @id @default(uuid())
  user_id         String
  atendimento     Int?
  certificado     Int?
  comercial       Int?
  contabil        Int?
  financeiro      Int?
  fiscal          Int?
  integracao      Int?
  marketing       Int?
  parcelamento    Int?
  pec             Int?
  pessoal         Int?
  regularize      Int?
  rh              Int?
  triagem         Int?
  wiki            Int?
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])
  userPrimary     User?        @relation("UserPrimaryPermission")

  @@map("permissions")
}

model PermissionSpecific {
  user_id         String       @id
  task_completion Boolean?
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("permissions.specific")
}

model PermissionProject {
  user_id                 String       @id
  block_tasks             Boolean
  urgent_tasks_monitoring Boolean
  organization_id         String
  organization            Organization @relation(fields: [organization_id], references: [id])

  @@map("permissions.project")
}

model Logs {
  id              String       @id @default(uuid())
  user_id         String
  action          String
  referring       String
  referring_id    String
  changes         Json
  date            DateTime     @default(now())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("logs")
}

model AuditRequest {
  id              String        @id @default(uuid())
  request_id      String        @unique
  organization_id String?
  user_id         String?
  permission      Int?
  method          String
  path            String
  query_json      Json?
  status_code     Int?
  outcome         String
  duration_ms     Int?
  ip              String?
  user_agent      String?
  origin          String?
  error_code      String?
  error_message   String?
  service_source  String
  metadata_json   Json?
  created_at      DateTime      @default(now())
  finished_at     DateTime?
  action          String?
  referring       String?
  referring_id    String?
  changes_json    Json?
  department      String?
  organization    Organization? @relation(fields: [organization_id], references: [id])
  user            User?         @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([path, created_at(sort: Desc)])
  @@index([status_code, created_at(sort: Desc)])
  @@index([organization_id, referring, referring_id, created_at(sort: Desc)])
  @@map("audit_requests")
}

model CertificateNotification {
  id              String       @id @default(uuid())
  certificate_id  String
  client_name     String
  type            String
  date            DateTime
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.certificate")
}

model PessoalNotification {
  id              String       @id @default(uuid())
  user_id         String
  regarding_id    String
  title           String
  message         String
  create_at       DateTime     @default(now())
  read            Boolean      @default(false)
  regarding       String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.pessoal")
}

model RegularizeNotification {
  id              String       @id @default(uuid())
  user_id         String
  regarding       String
  regarding_id    String
  title           String
  message         String
  read            Boolean      @default(false)
  create_at       DateTime     @default(now())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.regularize")
}

model Chat {
  id              String            @id @default(uuid())
  type            ChatType
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  photo           String?
  organization_id String
  organization    Organization      @relation(fields: [organization_id], references: [id])
  messages        Message[]
  participants    ChatParticipant[]

  @@map("chats")
}

model ChatParticipant {
  id              String       @id @default(uuid())
  chat_id         String
  user_id         String
  role            Role         @default(MEMBER)
  joinedAt        DateTime     @default(now())
  unreadCount     Int          @default(0)
  organization_id String
  chat            Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, user_id])
  @@map("chats.participants")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Message {
  id              String       @id @default(uuid())
  content         String?
  createdAt       DateTime     @default(now())
  chat_id         String
  sender_id       String
  type            MessageType  @default(TEXT)
  fileUrl         String?
  isEdited        Boolean      @default(false)
  organization_id String
  chat            Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  sender          User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@map("chats.messages")
}

