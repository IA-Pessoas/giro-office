model OrganizationInvite {
  id              String       @id @default(uuid())
  organization_id String
  email_user      String
  token           String
  expires_at      DateTime
  accepted_at     DateTime?
  role            enumType     @default(user)
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("organization_invites")
}

model Department {
  id                        String            @id @default(uuid())
  name                      String
  color                     String
  status                    String
  solution                  Boolean?
  organization_id           String
  agenda_controls           Agenda[]          @relation("department_control")
  agenda_recurring_controls RecurringAgenda[] @relation("department_control")
  budgets                   Budget[]
  organization              Organization      @relation(fields: [organization_id], references: [id])
  tasks                     Task[]
  tasksModel                TaskModel[]
  stocks                    Stock[]
  categorysStock            CategoryStock[]
  locationsStock            LocationStock[]
  users                     User[]
  financeiroCollectors      DepartmentCollector[]

  @@index([organization_id, name], map: "idx_departments_org_name")
  @@unique([organization_id, name], map: "uq_departments_org_name")
  @@map("departments")
}

model User {
  id                          String                 @id @default(uuid())
  name                        String
  login                       String
  password                    String
  permission                  Int
  status                      String
  organization_id             String?
  type                        enumType?
  first_owner_flag            Boolean?               @default(false)
  session_version             Int                    @default(0)
  version                     Int                    @default(1)
  permission_id               String?                @unique
  department_id               String
  invited_by                  String?
  joined_at                   DateTime?              @default(now())
  photo_url                   String?
  full_name                   String?
  gender                      String?
  birth_date                  DateTime?
  cpf                         String?                 @unique
  rg                          String?                 @unique
  address                     String?
  job_title                   String?
  email                       String?
  phone                       String?
  hire_date                   DateTime?
  dominio_hire_date           DateTime?
  termination_date            DateTime?
  allergies                   Json?
  emergency_contacts          Json?
  agenda2                     Agenda[]               @relation("participant2")
  agenda3                     Agenda[]               @relation("participant3")
  agenda                      Agenda[]               @relation("participant")
  agendaRecurring2            RecurringAgenda[]      @relation("participant2")
  agendaRecurring3            RecurringAgenda[]      @relation("participant3")
  agendaRecurring             RecurringAgenda[]      @relation("participant")
  auditRequests               AuditRequest[]
  sentMessages                Message[]
  chats                       ChatParticipant[]
  clientHistorys              ClientHistory[]
  clientHistorysPending       ClientHistoryPending[]
  personResponsible           ResponsibleContabil[]  @relation("person_responsible")
  postedByContabil            ResponsibleContabil[]  @relation("posted_by")
  sponso                      Project[]              @relation("sponsor")
  tasks2                      Task[]                 @relation("responsible2")
  tasks3                      Task[]                 @relation("responsible3")
  tasks                       Task[]                 @relation("responsible")
  tasksModel2                 TaskModel[]            @relation("responsible2")
  tasksModel3                 TaskModel[]            @relation("responsible3")
  tasksModel                  TaskModel[]            @relation("responsible")
  logs                        Logs[]
  notes                       Note[]
  organization                Organization?         @relation("UserOrganization", fields: [organization_id], references: [id])
  permissionRef               Permission?           @relation("UserPrimaryPermission", fields: [permission_id], references: [id])
  panoramasParcelameto        PanoramaParcelameto[]  @relation("responsavelPanorama")
  permissions                 Permission[]
  permissionsSpecifics        PermissionSpecific?
  obrigationsPessoal          ObrigationsPessoal[]
  passPessoal                 PasswordPessoal[]
  pessoalGroupMigrationMappings PessoalGroupMigrationMapping[] @relation("PessoalGroupMigrationMappedBy")
  payroll                     Payroll[]
  completedSituationsPessoal  SituationsPessoal[]    @relation("completed_by")
  registeredSituationsPessoal SituationsPessoal[]    @relation("registered_by")
  licensesResp                License[]
  processResp1                Process[]              @relation("responsible1")
  processResp2                Process[]              @relation("responsible2")
  processResp3                Process[]              @relation("responsible3")
  pointConfig                 PointsConfig?
  points                      Point[]
  senderMsgRH                 RhMessage[]
  assignerRH                  RhRequest[]            @relation("RequestAssignee")
  requesterRH                 RhRequest[]            @relation("RequestOwner")
  rhNotifications             RhNotification[]
  rhRequestReads              RhRequestRead[]
  rhMessageReads              RhMessageRead[]
  scores                      ScoreQuarter[]
  scoresEvaluaion             ScoreEvaluation[]
  timeBankRealeasesAdded      TimeBankReleases[]     @relation("add")
  timeBankRealeases           TimeBankReleases[]     @relation("user")
  timeClockRequestApproved    TimeClockRequest[]     @relation("approver")
  timeClockRequest            TimeClockRequest[]     @relation("user")
  timeSheets                  TimeSheets[]
  entrys                      EntryStock[]
  approversExists             ExitStock[]            @relation("approver")
  operatorsExists             ExitStock[]            @relation("operator")
  requestsExits               ExitStock[]            @relation("requester")
  extensions                  ExtensionsTecnologia[]
  staffInventory              InventoryTecnologia[]  @relation("staff")
  myInventory                 InventoryTecnologia[]  @relation("user")
  passwords                   PasswordTecnologia[]
  senderMsgTI                 TIMessage[]
  assigneerRequestsTI         TIRequest[]            @relation("TiAssignee")
  requestsTI                  TIRequest[]            @relation("TiRequester")
  terms                       TermTecnologia[]
  authSessions                AuthSession[]
  triageMonthlys              TriageMonthly[]
  responsiblesTriage          TriageResponsible[]
  triageCompetenceHistories   TriageCompetenceHistory[]
  triageExternalLinks         TriageExternalLink[]       @relation("TriageExternalLinkResponsible")
  triageUrgentRequestsCreated TriageUrgentRequest[]      @relation("TriageUrgentRequestRequester")
  triageUrgentRequestsAssigned TriageUrgentRequest[]     @relation("TriageUrgentRequestResponsible")
  financeiroCollectorAssignments DepartmentCollector[]
  taskOperationalNotifications TaskOperationalNotification[]
  department                  Department             @relation(fields: [department_id], references: [id])

  @@unique([login], map: "users_login_key")
  @@index([organization_id, name, id])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid())
  user_id    String
  csrf_hash  String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("auth_sessions")
}

model PlatformUser {
  id              String                @id @default(uuid())
  name            String
  email           String                @unique
  password        String
  platform_role   PlatformRole          @default(super_admin)
  status          String                @default("active")
  session_version Int                   @default(0)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  authSessions    PlatformAuthSession[]

  @@map("platform_users")
}

model PlatformAuthSession {
  id               String       @id @default(uuid())
  platform_user_id String
  csrf_hash        String
  expires_at       DateTime
  revoked_at       DateTime?
  created_at       DateTime     @default(now())
  platformUser     PlatformUser @relation(fields: [platform_user_id], references: [id], onDelete: Cascade)

  @@index([platform_user_id, revoked_at, expires_at], map: "idx_platform_auth_sessions_user_state")
  @@index([expires_at], map: "idx_platform_auth_sessions_expiry")
  @@map("platform_auth_sessions")
}

model Permission {
  id              String       @id @default(uuid())
  user_id         String
  certificado     Int      @default(0)
  comercial       Int      @default(0)
  contabil        Int      @default(0)
  financeiro      Int      @default(0)
  fiscal          Int      @default(0)
  integracao      Int      @default(0)
  marketing       Int      @default(0)
  parcelamento    Int      @default(0)
  pessoal         Int      @default(0)
  regularize      Int      @default(0)
  rh              Int      @default(0)
  ti              Int      @default(0)
  triagem         Int      @default(0)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])
  userPrimary     User?        @relation("UserPrimaryPermission")

  @@unique([user_id, organization_id], map: "uq_permissions_user_org")
  @@map("permissions")
}

model PermissionSpecific {
  user_id         String       @id
  task_completion Boolean?
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("permissions.specific")
}

model PermissionProject {
  user_id                 String       @id
  block_tasks             Boolean
  urgent_tasks_monitoring Boolean
  organization_id         String
  organization            Organization @relation(fields: [organization_id], references: [id])

  @@map("permissions.project")
}

model Logs {
  id              String       @id @default(uuid())
  user_id         String
  action          String
  referring       String
  referring_id    String
  changes         Json
  date            DateTime     @default(now())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id])

  @@map("logs")
}

model AuditRequest {
  id              String        @id @default(uuid())
  request_id      String        @unique
  organization_id String?
  user_id         String?
  permission      Int?
  method          String
  path            String
  query_json      Json?
  status_code     Int?
  outcome         String
  duration_ms     Int?
  ip              String?
  user_agent      String?
  origin          String?
  error_code      String?
  error_message   String?
  service_source  String
  metadata_json   Json?
  created_at      DateTime      @default(now())
  finished_at     DateTime?
  action          String?
  referring       String?
  referring_id    String?
  changes_json    Json?
  department      String?
  organization    Organization? @relation(fields: [organization_id], references: [id])
  user            User?         @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([path, created_at(sort: Desc)])
  @@index([status_code, created_at(sort: Desc)])
  @@index([organization_id, referring, referring_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "idx_audit_requests_created_id_desc")
  @@index([path(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_audit_requests_path_trgm")
  @@map("audit_requests")
}

model CertificateNotification {
  id              String       @id @default(uuid())
  certificate_id  String
  client_name     String
  type            String
  date            DateTime
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, certificate_id, type], name: "certificateNotificationIdentity", map: "uq_cert_not_org_cert_type")
  @@index([organization_id, date, client_name], map: "idx_cert_not_org_date_name")
  @@map("notification.certificate")
}

model PessoalNotification {
  id              String       @id @default(uuid())
  user_id         String
  regarding_id    String
  title           String
  message         String
  reference_date  DateTime     @default(now())
  create_at       DateTime     @default(now())
  read            Boolean      @default(false)
  regarding       String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, user_id, regarding, regarding_id, title, reference_date], map: "uq_pessoal_notification_identity")
  @@map("notification.pessoal")
}

model RegularizeNotification {
  id              String       @id @default(uuid())
  user_id         String
  regarding       String
  regarding_id    String
  title           String
  message         String
  reference_date  DateTime     @default(now())
  read            Boolean      @default(false)
  create_at       DateTime     @default(now())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, user_id, regarding, regarding_id, title, reference_date], map: "uq_regularize_notification_identity")
  @@map("notification.regularize")
}

model TaskOperationalNotification {
  id              String       @id @default(uuid())
  organization_id String
  recipient_id    String
  task_id         String
  event_key       String       @db.VarChar(191)
  type            String
  title           String
  message         String
  read_at         DateTime?
  archived_at     DateTime?
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id])
  recipient       User         @relation(fields: [recipient_id], references: [id])

  @@unique([organization_id, recipient_id, task_id, event_key], map: "uq_task_operational_notification_event")
  @@index([organization_id, recipient_id, archived_at, read_at, created_at], map: "idx_task_operational_notification_inbox")
  @@index([archived_at, created_at], map: "idx_task_operational_notification_retention")
  @@map("notification.task_operational")
}

model Chat {
  id              String            @id @default(uuid())
  type            ChatType
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  photo           String?
  organization_id String
  organization    Organization      @relation(fields: [organization_id], references: [id])
  messages        Message[]
  participants    ChatParticipant[]

  @@map("chats")
}

model ChatParticipant {
  id              String       @id @default(uuid())
  chat_id         String
  user_id         String
  role            Role         @default(MEMBER)
  joinedAt        DateTime     @default(now())
  unreadCount     Int          @default(0)
  organization_id String
  chat            Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, user_id])
  @@map("chats.participants")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Message {
  id              String       @id @default(uuid())
  content         String?
  createdAt       DateTime     @default(now())
  chat_id         String
  sender_id       String
  type            MessageType  @default(TEXT)
  fileUrl         String?
  isEdited        Boolean      @default(false)
  organization_id String
  chat            Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organization_id], references: [id])
  sender          User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@map("chats.messages")
}

