generator client {
  provider        = "prisma-client"
  output          = "../../services/src/src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

generator organizationClient {
  provider        = "prisma-client"
  output          = "../../services/organization-service/src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"  
}

// ------------ Organization (Multi-Tenancy Root) ------------
enum status {
  trial
  past_due
  active
  suspended
  cancelled
}
model Organization {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  logo_url       String?
  status     status   @default(active)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  email_created_by String 
  cnpj String @unique
  subscription_plan String @default("trial")



  departments                   Department[]
  users                         User[]
  permissions                   Permission[]
  permissionsSpecifics          PermissionSpecific[]
  permissionsProjects           PermissionProject[]
  logs                          Logs[]
  certificateNotifications      CertificateNotification[]
  pessoalNotifications          PessoalNotification[]
  regularizeNotifications       RegularizeNotification[]
  chats                         Chat[]
  chatParticipants              ChatParticipant[]
  messages                      Message[]
  clients                       Client[]
  clientsPF                     ClientPF[]
  pas                           PA[]
  clientHistorys                ClientHistory[]
  clientHistorysPending         ClientHistoryPending[]
  groups                        Group[]
  clientsGroups                 ClientsGroup[]
  clientTerminations            ClientTermination[]
  documentsTermination          DocumentClientTermination[]
  taskModels                    TaskModel[]
  taskDependents                TaskDependent[]
  projectPlans                  ProjectPlan[]
  projectPlanTasks              ProjectPlanTasks[]
  projects                      Project[]
  tasks                         Task[]
  proposalConfigs               ProposalConfig[]
  emails                        Emails[]
  agendas                       Agenda[]
  recurringAgendas              RecurringAgenda[]
  locationsStock                LocationStock[]
  categorysStock                CategoryStock[]
  stocks                        Stock[]
  entrysStock                   EntryStock[]
  exitsStock                    ExitStock[]
  notes                         Note[]
  budgets                       Budget[]
  certificatesPJ                CertificatePJ[]
  certificatesPF                CertificatePF[]
  controlsContabil              ControlContabil[]
  responsiblesContabil          ResponsibleContabil[]
  relationshipsContabil         RelationshipContabil[]
  ncms                          Ncm[]
  icms                          Icms[]
  ipis                          Ipi[]
  passwordsMkt                  PasswordMkt[]
  installments                  Installment[]
  installmentCompetencies       InstallmentCompetencies[]
  panoramasParcelamento         PanoramaParcelameto[]
  lddPessoal                    LddPessoal[]
  passwordsPessoal              PasswordPessoal[]
  unionsPessoal                 UnionPessoal[]
  payrolls                      Payroll[]
  obrigationsPessoal            ObrigationsPessoal[]
  situationsPessoal             SituationsPessoal[]
  sitePasswordsRegularize       SitePasswordsRegularize[]
  passwordsRegularize           PasswordRegularize[]
  licenses                      License[]
  processes                     Process[]
  proceduralGuidances           ProceduralGuidance[]
  partners                      Partners[]
  municipalTaxes                MunicipalTaxes[]
  tasksIntegrationRegularize    TasksIntegrationRegularize[]
  colaborators                  Colaborators[]
  emergencyContacts             EmergencyContacts[]
  allergies                     Allergies[]
  pointsConfig                  PointsConfig[]
  timeSheets                    TimeSheets[]
  timeBankReleases              TimeBankReleases[]
  points                        Point[]
  timeClockRequests             TimeClockRequest[]
  holidays                      Holidays[]
  scoreQuarters                 ScoreQuarter[]
  scoreNitros                   ScoreNitro[]
  scoreQuestions                ScoreQuestion[]
  scoreEvaluations              ScoreEvaluation[]
  rhRequests                    RhRequest[]
  rhCategories                  RhCategory[]
  rhMessages                    RhMessage[]
  passwordsTecnologia           PasswordTecnologia[]
  extensionsTecnologia          ExtensionsTecnologia[]
  inventoryCategoriesTecnologia InventoryCategoryTecnologia[]
  inventoryLocationsTecnologia  InventoryLocationTecnologia[]
  inventoryTecnologia           InventoryTecnologia[]
  termsTecnologia               TermTecnologia[]
  tiRequests                    TIRequest[]
  tiCategories                  TICategoryRequest[]
  tiMessages                    TIMessage[]
  triageConfigs                 TriageConfig[]
  triageMonthlys                TriageMonthly[]
  clientClouds                  ClientClouds[]
  triageResponsibles            TriageResponsible[]
  organizationUsers             OrganizationUser[]
  organizationInvites           OrganizationInvite[]
  @@map("organizations")
}



enum enumType {
  admin
  owner
  user
}
model OrganizationUser {
  id String @id @default(uuid())
  organization_id String
  user_id String
  type enumType @default(user)
  first_owner_flag Boolean? @default(false)
  organization Organization @relation(fields: [organization_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@map("organization_users")
}

model OrganizationInvite {
  id String @id @default(uuid())
  organization_id String
  email_user String
  token String
  expires_at DateTime
  accepted_at DateTime?
  role enumType @default(user)
  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("organization_invites")
}

// ------------ Organization (Multi-Tenancy Root) ------------ //

// ------------ Core ------------

model Department {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  color           String
  status          String
  solution        Boolean?

  organization              Organization      @relation(fields: [organization_id], references: [id])
  users                     User[]
  tasksModel                TaskModel[]
  tasks                     Task[]
  agenda_controls           Agenda[]          @relation("department_control")
  agenda_recurring_controls RecurringAgenda[] @relation("department_control")
  locationsStock            LocationStock[]
  categorysStock            CategoryStock[]
  stocks                    Stock[]
  budgets                   Budget[]

  @@map("departments")
}

model User {
  id              String  @id @default(uuid())
  organization_id String
  name            String
  login           String
  password        String
  department_id   String
  permission      Int
  status          String
  photo_url          String?
  invited_by         String?
  joined_at          DateTime? @default(now())

  organization         Organization         @relation(fields: [organization_id], references: [id])
  organizationUsers    OrganizationUser[]
  permissions          Permission[]
  permissionsSpecifics PermissionSpecific[]
  logs                 Logs[]

  department            Department             @relation(fields: [department_id], references: [id])
  sponso                Project[]              @relation("sponsor")
  tasksModel            TaskModel[]            @relation("responsible")
  tasksModel2           TaskModel[]            @relation("responsible2")
  tasksModel3           TaskModel[]            @relation("responsible3")
  tasks                 Task[]                 @relation("responsible")
  tasks2                Task[]                 @relation("responsible2")
  tasks3                Task[]                 @relation("responsible3")
  chats                 ChatParticipant[]
  sentMessages          Message[]
  agenda                Agenda[]               @relation("participant")
  agenda2               Agenda[]               @relation("participant2")
  agenda3               Agenda[]               @relation("participant3")
  agendaRecurring       RecurringAgenda[]      @relation("participant")
  agendaRecurring2      RecurringAgenda[]      @relation("participant2")
  agendaRecurring3      RecurringAgenda[]      @relation("participant3")
  clientHistorys        ClientHistory[]
  clientHistorysPending ClientHistoryPending[]
  entrys                EntryStock[]
  requestsExits         ExitStock[]            @relation("requester")
  approversExists       ExitStock[]            @relation("approver")
  operatorsExists       ExitStock[]            @relation("operator")
  notes                 Note[]

  personResponsible ResponsibleContabil[] @relation("person_responsible")
  postedByContabil  ResponsibleContabil[] @relation("posted_by")

  panoramasParcelameto PanoramaParcelameto[] @relation("responsavelPanorama")

  passPessoal                 PasswordPessoal[]
  payroll                     Payroll[]
  obrigationsPessoal          ObrigationsPessoal[]
  registeredSituationsPessoal SituationsPessoal[]  @relation("registered_by")
  completedSituationsPessoal  SituationsPessoal[]  @relation("completed_by")

  licensesResp License[]
  processResp1 Process[] @relation("responsible1")
  processResp2 Process[] @relation("responsible2")
  processResp3 Process[] @relation("responsible3")

  colaborator              Colaborators[]
  emergencyContacts        EmergencyContacts[]
  allergies                Allergies[]
  pointConfig              PointsConfig[]
  timeSheets               TimeSheets[]
  points                   Point[]
  timeBankRealeases        TimeBankReleases[]  @relation("user")
  timeBankRealeasesAdded   TimeBankReleases[]  @relation("add")
  timeClockRequest         TimeClockRequest[]  @relation("user")
  timeClockRequestApproved TimeClockRequest[]  @relation("approver")
  scores                   ScoreQuarter[]
  scoresEvaluaion          ScoreEvaluation[]
  requesterRH              RhRequest[]         @relation("RequestOwner")
  assignerRH               RhRequest[]         @relation("RequestAssignee")
  senderMsgRH              RhMessage[]

  passwords           PasswordTecnologia[]
  extensions          ExtensionsTecnologia[]
  myInventory         InventoryTecnologia[]  @relation("user")
  staffInventory      InventoryTecnologia[]  @relation("staff")
  terms               TermTecnologia[]
  requestsTI          TIRequest[]            @relation("TiRequester")
  assigneerRequestsTI TIRequest[]            @relation("TiAssignee")
  senderMsgTI         TIMessage[]

  triageMonthlys     TriageMonthly[]
  responsiblesTriage TriageResponsible[]

  @@map("users")
}

model Permission {
  id              String @id @default(uuid())
  organization_id String
  user_id         String
  atendimento     Int?
  certificado     Int?
  comercial       Int?
  contabil        Int?
  financeiro      Int?
  fiscal          Int?
  integracao      Int?
  marketing       Int?
  parcelamento    Int?
  pec             Int?
  pessoal         Int?
  regularize      Int?
  rh              Int?
  triagem         Int?
  wiki            Int?

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@map("permissions")
}

model PermissionSpecific {
  user_id         String   @id
  organization_id String
  task_completion Boolean?

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@map("permissions.specific")
}

model PermissionProject {
  user_id                 String  @id
  organization_id         String
  block_tasks             Boolean
  urgent_tasks_monitoring Boolean

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("permissions.project")
}

// ------------ Core ------------ //

// ------------ Logs ------------
model Logs {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  action          String
  referring       String
  referring_id    String
  changes         Json
  date            DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@map("logs")
}


// ------------ Logs ------------ //

// ------------ Notifications ------------ 
model CertificateNotification {
  id              String   @id @default(uuid())
  organization_id String
  certificate_id  String
  client_name     String
  type            String
  date            DateTime

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.certificate")
}

model PessoalNotification {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  regarding       String
  regarding_id    String
  title           String
  message         String
  read            Boolean  @default(false)
  create_at       DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.pessoal")
}

model RegularizeNotification {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  regarding       String
  regarding_id    String
  title           String
  message         String
  read            Boolean  @default(false)
  create_at       DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("notification.regularize")
}

// ------------ Notifications ------------ //

// ------------ Chat ------------
enum ChatType {
  DIRECT
  GROUP
}

enum Role {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DELETED
}

model Chat {
  id              String   @id @default(uuid())
  organization_id String
  type            ChatType
  name            String
  photo           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  participants ChatParticipant[]
  messages     Message[]

  @@map("chats")
}

model ChatParticipant {
  id              String   @id @default(uuid())
  organization_id String
  chat_id         String
  user_id         String
  role            Role     @default(MEMBER)
  joinedAt        DateTime @default(now())
  unreadCount     Int      @default(0)

  organization Organization @relation(fields: [organization_id], references: [id])
  chat         Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, user_id])
  @@map("chats.participants")
}

model Message {
  id              String      @id @default(uuid())
  organization_id String
  content         String?     @db.Text
  fileUrl         String?
  type            MessageType @default(TEXT)
  isEdited        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  chat_id         String
  sender_id       String

  organization Organization @relation(fields: [organization_id], references: [id])
  chat         Chat         @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@map("chats.messages")
}

// ------------ Chat ------------ //

// ------------ Client ------------
model Client {
  id                            String    @id @default(uuid())
  organization_id               String
  type                          String    @default("PJ")
  dominio_code                  String?
  name                          String
  company_name                  String?
  fantasy_name                  String?
  cpf_cnpj                      String    @default("")
  cnae                          String?
  cnae_secondary                String?
  responsible                   String?
  cpf_responsible               String?
  agent                         String?
  cpf_agent                     String?
  number                        String?
  email                         String?
  address                       String?
  cep                           String?
  neighborhood                  String?
  state                         String?
  city                          String?
  customer_since                DateTime?
  municipal_registration        String?
  state_registration            String?
  commercial_board_registration String?
  status                        String
  competence_entry              DateTime?
  competence_output             DateTime?
  opening_date                  DateTime?
  instagram                     String?
  indication                    String?
  participants_meet             String?
  meet_type                     String?
  type_registration             String    @default("Novo")

  regime        String?
  size          String?
  segment       String?
  contabil      Boolean?
  fiscal        Boolean?
  pessoal       Boolean?
  infoproduto   Boolean?
  consultoria   Boolean?
  castelo_med   Boolean?
  start_strike  DateTime?
  end_strike    DateTime?
  deletion_date DateTime?

  contract                  Boolean?
  prospecting_status        String
  date_status               DateTime?
  description_prospecting   String?
  register_date_prospecting DateTime  @default(now())
  closing_date              DateTime?

  service_unique Boolean?

  organization Organization @relation(fields: [organization_id], references: [id])

  agenda          Agenda[]
  agendaRecurring RecurringAgenda[]
  historys        ClientHistory[]
  historysPe      ClientHistoryPending[]
  notes           Note[]

  projects Project[]
  tasks    Task[]
  pa       PA[]
  groups   ClientsGroup[]

  termination          ClientTermination[]
  documentsTermination DocumentClientTermination[]

  controlContabil      ControlContabil[]
  responsibleContabil  ResponsibleContabil[]
  relationshipContabil RelationshipContabil[]
  installments         Installment[]
  panoramasParcelameto PanoramaParcelameto[]

  lddPessoal         LddPessoal[]
  passPessoal        PasswordPessoal[]
  obrigationsPessoal ObrigationsPessoal[]
  situationsPessoal  SituationsPessoal[]

  passRegularize PasswordRegularize[]
  licenses       License[]
  process        Process[]
  partners       Partners[]
  municipalTaxes MunicipalTaxes[]

  triageConfigs      TriageConfig[]
  triageMonthlys     TriageMonthly[]
  clouds             ClientClouds[]
  responsiblesTriage TriageResponsible[]

  @@map("clients")
}

model PA {
  client_id                 String   @id
  organization_id           String
  activities                String?
  tax_billing               String?
  management_billing        String?
  works_bidding             Boolean?
  dissatisfaction           String?
  registered_collabortors   Int?
  unregistered_collabortors Int?
  esocial                   Boolean?
  how_many_banks            Boolean?
  whitch_banks              String?
  responsible_departments   String?
  works_system              Boolean?
  system_name               String?
  system_usage_time         String?
  system_value              String?
  system_contact            String?
  system_operations         String?
  cloud_storage             Boolean?
  which_cloud_storage       String?
  rental_agreement          Boolean?
  assessment_regime         String?
  permit                    String?
  services                  String?

  organization Organization @relation(fields: [organization_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])

  @@map("clients.pa")
}

model ClientHistory {
  id              String   @id @default(uuid())
  organization_id String
  client_id       String
  date            DateTime
  history         String
  file            String?
  user_id         String

  organization Organization @relation(fields: [organization_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@map("clients.history")
}

model ClientHistoryPending {
  id              String @id @default(uuid())
  organization_id String
  user_id         String
  client_id       String
  reason          String

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])

  @@map("clients.historyPending")
}

model Group {
  id              String  @id @default(uuid())
  organization_id String
  name            String
  status          Boolean @default(true)

  organization Organization   @relation(fields: [organization_id], references: [id])
  clients      ClientsGroup[]

  @@map("clients.group")
}

model ClientsGroup {
  id              String @id @default(uuid())
  organization_id String
  group_id        String
  client_id       String

  organization Organization @relation(fields: [organization_id], references: [id])
  group        Group        @relation(fields: [group_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])

  @@map("clients.clientsGroup")
}

model ClientTermination {
  id              String   @id @default(uuid())
  organization_id String
  client_id       String
  reason          String
  description     String
  competence      String
  date            DateTime @default(now())
  user_id         String

  organization Organization @relation(fields: [organization_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])

  @@map("clients.termination")
}

model DocumentClientTermination {
  id                        String   @id @default(uuid())
  organization_id           String
  client_id                 String
  address                   String
  legal_representative_name String
  legal_representative_cpf  String
  legal_representative_rg   String
  third_clause_competence   String
  fourh_clause_competence   String
  sixth_clause_type         String
  date                      DateTime

  organization Organization @relation(fields: [organization_id], references: [id])
  client       Client       @relation(fields: [client_id], references: [id])

  @@map("clients.documentTermination")
}

