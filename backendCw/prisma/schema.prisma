  approver User? @relation("approver", fields: [approver_id], references: [id])
}
model Holidays {
  id                String        @id @default(uuid())
  name              String        // Nome
  date              DateTime      // Data

  @@map("rh.holidays")
}
// SCORE E JORNADA
model ScoreQuarter {
  id              String   @id @default(uuid())
  user_id         String   // Colaborador
  quarter         String   // Trimestre - Ex: "2025-Q1", "2025-Q2"
  
  // Pontuações calculadas
  behavioral      Float    @default(0) // Comportamental
  technical       Float    @default(0) // Técnico
  technology      Float    @default(0) // Tecnologia (se houver)
  leadership      Float    @default(0) // Líder (se houver)
  
  final_score     Float    @default(0) // Nota Final Calculada

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User     @relation(fields: [user_id], references: [id])
  nitro           ScoreNitro?
  evaluations     ScoreEvaluation[]

  @@unique([user_id, quarter]) // Um score por usuário por trimestre
  @@map("rh.score")
}
model ScoreNitro {
  id              String   @id @default(uuid())
  score_id        String   @unique
  
  projects_score  Float    @default(0)
  hours_score     Float    @default(0) // Baseado em CH
  errors_score    Float    @default(0)
  folders_score   Float    @default(0) // Organização de pastas
  
  // Dados brutos para histórico
  total_hours     Int      @default(0) // Minutos
  total_errors    Int      @default(0) 
  
  scoreQuarter    ScoreQuarter @relation(fields: [score_id], references: [id], onDelete: Cascade)

  @@map("rh.score_nitro")
}
model ScoreQuestion {
  id              String   @id @default(uuid())
  question        String   // A pergunta
  type            String   // 'behavioral', 'technical', 'tech', 'leadership'
  active          Boolean  @default(true)

  @@map("rh.score_questions")
}
model ScoreEvaluation {
  id              String   @id @default(uuid())
  score_id        String
  
  // Agora pode ser NULL. Se for NULL, qualquer usuário com o 'evaluator_role' pode responder.
  evaluator_id    String?  
  
  // Papeis: 'SELF', 'LEADER', 'RH', 'TI', 'DIRECTOR', 'SUBORDINATE'
  evaluator_role  String   
  
  type            String   // 'behavioral', 'technical', 'tech', 'leadership'
  status          String   // 'Pendente', 'Concluido'
  answers         Json     
  average_score   Float    @default(0)

  scoreQuarter    ScoreQuarter @relation(fields: [score_id], references: [id], onDelete: Cascade)
  evaluator       User?    @relation(fields: [evaluator_id], references: [id])

  @@map("rh.score_evaluations")
}
// SOLICITAÇÕES
model RhRequest {
  id              String   @id @default(uuid())
  title           String
  description     String   // Descrição inicial
  
  requester_id    String   // Quem abriu o chamado
  category_id     String   // Tipo de chamado
  assigned_to_id  String?  // Quem do RH pegou (opcional no inicio)
  
  urgency         String   // 'Baixa', 'Media', 'Alta' (Mapeado do 1, 2, 3)
  status          String   // 'Novo', 'Andamento', 'Solucionado', 'Finalizado'
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  requester       User     @relation("RequestOwner", fields: [requester_id], references: [id])
  assigned_to     User?    @relation("RequestAssignee", fields: [assigned_to_id], references: [id])
  category        RhCategory @relation(fields: [category_id], references: [id])
  messages        RhMessage[]

  @@map("rh.requests")
}
model RhCategory {
  id              String   @id @default(uuid())
  name            String
  active          Boolean  @default(true)
  
  requests        RhRequest[]

  @@map("rh.request_categories")
}
model RhMessage {
  id              String   @id @default(uuid())
  request_id      String
  sender_id       String   // Quem enviou a mensagem
  
  message         String
  attachment      String?  // URL do anexo se houver
  type            String   // 'Message', 'Solution', 'Rejection', 'Acceptance'
  
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  request         RhRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  sender          User      @relation(fields: [sender_id], references: [id])

  @@map("rh.request_messages")
}
// ------------ RH ------------ //

// ------------ Tecnologia ------------
model PasswordTecnologia {
  id        String   @id @default(uuid())
  local     String   // Local
  user_id   String   // Usuário
  password  String   // Senha
  notes     String?  // Obs
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("tecnologia.passwords_users")
}
model ExtensionsTecnologia {
  id        String   @id @default(uuid())
  user_id   String   // Usuário
  number    String   // Número

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("tecnologia.extensions")
}
model InventoryCategoryTecnologia {
  id        String   @id @default(uuid())
  name      String   // Nome
  tag       String?  // Tag
  active    Boolean   @default(true) // Ativo

  @@map("tecnologia.inventoryCategories")

  inventory InventoryTecnologia[]
}
model InventoryLocationTecnologia {
  id        String    @id @default(uuid())
  name      String    // Nome
  active    Boolean   @default(true) // Ativo

  @@map("tecnologia.inventoryLocations")

  inventory InventoryTecnologia[]
}
model InventoryTecnologia {
  id                      String          @id @default(uuid())
  user_id                 String?         // Usuário
  location_id             String?         // Local
  category_id             String          // Categoria
  asset_code              String          // Código do equipemaneto
  notes                   String?         // Observações
  delivery_date           DateTime?       // Data de entrega
  return_date             DateTime?       // Data de retorno
  responsible_it_staff_id String?         // Responsavel do TI

  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  user User? @relation("user", fields: [user_id], references: [id])
  location InventoryLocationTecnologia? @relation(fields: [location_id], references: [id])
  category InventoryCategoryTecnologia @relation(fields: [category_id], references: [id])
  responsible_it_staff User? @relation("staff", fields: [responsible_it_staff_id], references: [id])

  @@map("tecnologia.inventory")
}
model TermTecnologia {
  id              String     @id   @default(uuid())
  user_id         String?    // Usuário
  date            DateTime   // Data
  user_name       String     // Nome do usuário
  user_cpf        String     // CPF do usuário
  department_id   String?    // Departamento do Usuário
  address         String?    // Endereço
  reason          String?    // Motivo
  equipament_list String?    // Lista de equipamentos
  brand           String?    // Marca
  asset_code      String?    // Código / Nº de Série
  imei            String?    // IMEI

  @@map("tecnologia.terms")

  user User? @relation(fields: [user_id], references: [id])
}
model TIRequest {
  id              String   @id @default(uuid())
  title           String
  description     String
  
  requester_id    String
  category_id     String
  assigned_to_id  String?
  
  urgency         String   // 'Baixa', 'Media', 'Alta'
  status          String   // 'Novo', 'Andamento', 'Solucionado', 'Finalizado'
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  requester       User     @relation("TiRequester", fields: [requester_id], references: [id])
  assigned_to     User?    @relation("TiAssignee", fields: [assigned_to_id], references: [id])
  category        TICategoryRequest @relation(fields: [category_id], references: [id])
  messages        TIMessage[]

  @@map("tecnologia.requests")
}
model TICategoryRequest {
  id      String   @id @default(uuid())
  name    String
  active  Boolean  @default(true)
  
  requests TIRequest[]

  @@map("tecnologia.request_categories")
}
model TIMessage {
  id              String   @id @default(uuid())
  request_id      String
  sender_id       String
  
  message         String
  attachment      String?
  type            String   // 'Message', 'Solution', 'Rejection', 'Acceptance'
  
  created_at      DateTime @default(now())

  request         TIRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  sender          User      @relation(fields: [sender_id], references: [id])

  @@map("tecnologia.request_messages")
}
