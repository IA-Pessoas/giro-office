// ------------ Project ------------
model TaskModel {
  id                String @id @default(uuid())
  name              String
  department_id     String
  responsible_id    String
  responsible2_id   String?
  responsible3_id   String?
  observations      String?
  billing           String // Cobrança
  prevision         Int
  type              String?

  @@map("integracao.tasksModel")

  department        Department       @relation(fields: [department_id], references: [id])
  responsible       User             @relation("responsible", fields: [responsible_id], references: [id])
  responsible2      User?            @relation("responsible2", fields: [responsible2_id], references: [id])
  responsible3      User?            @relation("responsible3", fields: [responsible3_id], references: [id])
  dependencies      TaskDependent[]  @relation("ParentTask") // Tarefas dependentes
  isDependenciesOf  TaskDependent[]  @relation("DependentTask") // Tarefas que dependem
  
  tasks Task[]
  plans ProjectPlanTasks[]
  taskRegularize TasksIntegrationRegularize[]
}
model TaskDependent {
  id            String @id @default(uuid())
  task_id       String
  dependent_id  String
  wait          Boolean
  observation   String

  @@map("integracao.tasksDependent")

  task      TaskModel @relation("ParentTask", fields: [task_id], references: [id])
  dependent TaskModel @relation("DependentTask", fields: [dependent_id], references: [id]) 
}
model ProjectPlan {
  id    String @id @default(uuid())
  name  String                      // Nome do plano
  color String                      // Cor do plano

  @@map("integracao.projectPlan")

  tasks ProjectPlanTasks[]
}
model ProjectPlanTasks {
  id          String @id @default(uuid())
  plan_id     String  // ID do plano
  task_id     String  // ID da tarefa
  order       Int     // Ordem da tarefa no plano

  @@map("integracao.projectPlanTasks")

  tasks TaskModel @relation(fields: [task_id], references: [id])
  plans ProjectPlan @relation(fields: [plan_id], references: [id])
}
model Project {
  id String @id @default(uuid())
  name String
  client_id String
  status String
  start_date DateTime? 
  end_date DateTime? 
  objective String?
  sponsor_id String? // Padrinho
  porcentage Float
  
  @@map("integracao.projects")
  
  tasks Task[]
  client Client @relation(fields: [client_id], references: [id])
  sponsor User? @relation("sponsor", fields: [sponsor_id], references: [id])
}
model Task {
  id                  String        @id @default(uuid())
  model_id            String        // ID do modelo da tarefa
  project_id          String        // ID do projeto
  client_id           String        // ID do cliente
  name                String        // Nome
  status              String        // Status
  department_id       String        // ID do departamento
  observations        String?       // Observações
  billing             String        // Tipo de cobrança
  urgency             String        // Urgência do projeto
  justification       String?       // Justificativa
  responsible_id      String        // Responsável principal
  responsible2_id     String?       // Responsável secundário
  responsible3_id     String?       // Terceiro responsável

  start_date          DateTime?     // Data de início
  prevision_date      DateTime?     // Previsão de entrega
  end_date            DateTime?     // Data de conclusão
  date_created        DateTime?     @default(now())  // Data de criação
  date_updated        DateTime?     @updatedAt       // Data de atualização automática

  pending_approval    Boolean?      // Aguardando aprovação de conclusao

  meeting             String?       //Reunião
  
  charge_comercial    Boolean?      // Cobrança do comercial
  hiring_status       String?       // Status da Contratação
  payment             String?       // Forma de pagamento
  billing_description String?       // Descrição de cobrança
  charge_financeiro   Boolean?      // Cobrança do financeiro


  @@map("integracao.tasks")

  project              Project @relation(fields: [project_id], references: [id])
  client               Client @relation(fields: [client_id], references: [id])
  department           Department @relation(fields: [department_id], references: [id])
  responsible          User @relation("responsible", fields: [responsible_id], references: [id])
  responsible2         User? @relation("responsible2", fields: [responsible2_id], references: [id])
  responsible3         User? @relation("responsible3", fields: [responsible3_id], references: [id])
  taskModel            TaskModel? @relation(fields: [model_id], references: [id])
  agenda               Agenda[]

  license              License[]
  process              Process[]
}
// ------------ Project ------------ //

// ------------ Commercial ------------
model ProposalConfig {
  id String @id @default(uuid())
  name String // Nome
  minimum_wage Float // Salário minimo

  @@map("proposal.config")
}
// ------------ Commercial -------- //

// ------------ E-mails ------------
model Emails {
  id                    String         @id @default(uuid())
  email                 String
  responsible           String         // Responsável
  new_client_sending    Boolean        // Envio Cliente novo
  task_stalled_sending  Boolean        // Envio Produto paralisada no projeto
  
  @@map("emails")
}
// ------------ E-mails -------- //

// ------------ Agenda ------------
model Agenda {
  id                    String      @id @default(uuid())
  agenda                String      // Pauta
  date                  DateTime    // Data
  client_id             String?     // Cliente ID
  location              String?     // Local
  participant_id        String?     // Participante ID
  participant_id_2      String?     // Participante ID 2
  participant_id_3      String?     // Participante ID 3
  task_id               String?     // Tarefa ID
  status                String?     // Status
  obs                   String?     // Observações
  department_control_id String      // Departamento de Control ID

  @@map("agenda")

  client Client? @relation(fields: [client_id], references: [id])
  participant User? @relation("participant", fields: [participant_id], references: [id])
  participant2 User? @relation("participant2", fields: [participant_id_2], references: [id])
  participant3 User? @relation("participant3", fields: [participant_id_3], references: [id])
  task Task? @relation(fields: [task_id], references: [id])
  department_control Department @relation("department_control", fields: [department_control_id], references: [id])
}
model RecurringAgenda {
  id                    String      @id @default(uuid())
  agenda                String      // Pauta
  day                   Int         // Dia
  recurrence            String      // Recorrência
  client_id             String?     // Cliente ID
  location              String?     // Local
  participant_id        String?     // Participante ID
  participant_id_2      String?     // Participante ID 2
  participant_id_3      String?     // Participante ID 3
  obs                   String?     // Observações
  department_control_id String      // Departamento de Control ID

  @@map("agenda.recurring")

  client Client? @relation(fields: [client_id], references: [id])
  participant User? @relation("participant", fields: [participant_id], references: [id])
  participant2 User? @relation("participant2", fields: [participant_id_2], references: [id])
  participant3 User? @relation("participant3", fields: [participant_id_3], references: [id])
  department_control Department @relation("department_control", fields: [department_control_id], references: [id])
}
// ------------ Agenda -------- //

// ------------ Stock --------
model LocationStock {
  id                String        @id @default(uuid())
  name              String        // Nome da localização
  floor             Int?          // Andar da Localização
  department_id     String        // Departamento ID
  status            Boolean       @default(true) // Status

  @@map("stock.locations")

  department Department @relation(fields: [department_id], references: [id])

  stocks Stock[]
  exits ExitStock[]
}

model CategoryStock {
  id                String        @id @default(uuid())
  name              String        // Nome da categoria
  department_id     String        // Departamento ID
  status            Boolean       @default(true) // Status

  @@map("stock.categories")

  department Department @relation(fields: [department_id], references: [id])

  stocks Stock[]
}

model Stock {
  id                String        @id @default(uuid())
  department_id     String        // Departamento ID
  name              String        // Nome do item
  category_id       String        // Categoria ID
  location_id       String        // Localização ID
  quantity          Int           // Quantidade
  description       String?       // Descrição
  status            Boolean       @default(true) // Status

  @@map("stock")

  category CategoryStock @relation(fields: [category_id], references: [id])
  location LocationStock @relation(fields: [location_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  entries EntryStock[]
  exits ExitStock[]
}

model EntryStock {
  id                String        @id @default(uuid())
  stock_id          String        // Item ID
  quantity          Int           // Quantidade
  entry_date        DateTime      // Data de entrada
  entry_by_user_id  String        // Usuário ID

  @@map("stock.entries")

  stock Stock @relation(fields: [stock_id], references: [id])
  entry_by_user User @relation(fields: [entry_by_user_id], references: [id])
}

model ExitStock {
  id                        String            @id @default(uuid())
  stock_id                  String            // Item ID
  quantity                  Int               // Quantidade
  destination               String?           // Destino
  exit_date                 DateTime          // Data de saída
  requester_id              String            // Solicitante ID
  approver_id               String?           // Aprovador ID
  operator_id               String?           // Operador ID
  location_destination_id   String?           // Localização de destino

  @@map("stock.exits")

  stock Stock @relation(fields: [stock_id], references: [id])
  requester User @relation("requester", fields: [requester_id], references: [id])
  approver User? @relation("approver", fields: [approver_id], references: [id])
