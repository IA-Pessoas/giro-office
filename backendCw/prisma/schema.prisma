// ------------ Triagem ------------
model TriageConfig {
  id              String   @id @default(uuid())
  client_id       String
  type            String   // 'CONTABIL' ou 'FISCAL'
  
  // Array de strings com os nomes dos campos que esse cliente UTILIZA.
  // Ex: ["financial_transactions", "inventory_control"]
  active_items    Json     

  updated_at      DateTime @updatedAt

  client          Client   @relation(fields: [client_id], references: [id])

  @@unique([client_id, type]) // Um config por tipo por cliente
  @@map("triagem.configs")
}
model TriageMonthly {
  id              String   @id @default(uuid())
  client_id       String
  competence      String   // "MM/AAAA"
  type            String   // 'CONTABIL' ou 'FISCAL'
  
  // O Checklist em si. 
  // Ex: { "financial_transactions": "concluido", "inventory_control": "nao possui" }
  checklist       Json     

  // Campos específicos de Data/Valor que não são status
  download_date   DateTime? // Para Contábil (Data de baixa)
  settlement_date DateTime? // Para Fiscal (Data da baixa)
  billing_amount  String?   // Para Fiscal (Faturamento)
  
  // Metadados
  triad_moviment  Boolean   @default(false) // Movimento Triado (Checkbox geral)
  responsible_id  String?
  notes           String?
  justification   String?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  client          Client    @relation(fields: [client_id], references: [id])
  responsible     User?     @relation(fields: [responsible_id], references: [id])

  @@unique([client_id, competence, type]) // Evita duplicidade no mesmo mês
  @@map("triagem.monthly")
}
model ClientClouds {
  id          String   @id @default(uuid())
  client_id   String   // ID do Cliente
  type        String   // Ex: "Google Drive", "OneDrive", "Dropbox", "Sistema Financeiro"
  link        String   // URL
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client      Client   @relation(fields: [client_id], references: [id])

  @@map("clientes.clouds")
}
// --- TRIAGEM: RESPONSÁVEIS ---
model TriageResponsible {
  id          String   @id @default(uuid())
  client_id   String   // Cliente
  user_id     String   // Usuário Responsável (person_responsible)
  
  // O campo "obs" que define o departamento ('CONTABIL' ou 'FISCAL')
  type        String   
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client      Client   @relation(fields: [client_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  // Garante que não tenha 2 responsáveis do mesmo tipo para o mesmo cliente
  // (Se puder ter mais de um, remova esta linha @@unique)
  @@unique([client_id, type]) 
  @@map("triagem.responsibles")
}
