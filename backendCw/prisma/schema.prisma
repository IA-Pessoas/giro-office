generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
  previewFeatures = ["fullTextIndex", "fullTextSearch"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------ Core ------------

model Department {
  id String @id @default(uuid())
  name String
  color String
  status String
  solution Boolean?

  @@map("departments")

  users User[]
  tasksModel TaskModel[]
  tasks Task[]
  agenda_controls Agenda[] @relation("department_control")
  agenda_recurring_controls RecurringAgenda[] @relation("department_control")
  locationsStock LocationStock[]
  categorysStock CategoryStock[]
  stocks Stock[]
  budgets Budget[]
}
model User {
  id String @id @default(uuid())
  name String
  login String
  password String
  department_id String
  permission Int
  status String
  photo String?

  @@map("users")

  permissions Permission[]
  permissionsSpecifics PermissionSpecific[]
  logs Logs[]
  logsPessoal LogsPessoal[]

  department Department @relation(fields: [department_id], references: [id])
  sponso Project[] @relation("sponsor")
  tasksModel TaskModel[] @relation("responsible")
  tasksModel2 TaskModel[] @relation("responsible2")
  tasksModel3 TaskModel[] @relation("responsible3")
  tasks Task[] @relation("responsible")
  tasks2 Task[] @relation("responsible2")
  tasks3 Task[] @relation("responsible3")
  chats ChatParticipant[]
  sentMessages Message[]
  agenda Agenda[] @relation("participant")
  agenda2 Agenda[] @relation("participant2")
  agenda3 Agenda[] @relation("participant3")
  agendaRecurring RecurringAgenda[] @relation("participant")
  agendaRecurring2 RecurringAgenda[] @relation("participant2")
  agendaRecurring3 RecurringAgenda[] @relation("participant3")
  clientHistorys ClientHistory[]
  clientHistorysPending ClientHistoryPending[]
  entrys EntryStock[]
  requestsExits ExitStock[] @relation("requester")
  approversExists ExitStock[] @relation("approver")
  operatorsExists ExitStock[] @relation("operator")
  notes Note[]

  personResponsible ResponsibleContabil[] @relation("person_responsible")
  postedByContabil ResponsibleContabil[] @relation("posted_by")

  panoramasParcelameto PanoramaParcelameto[] @relation("responsavelPanorama")

  passPessoal PasswordPessoal[]
  payroll Payroll[]
  obrigationsPessoal ObrigationsPessoal[]
  registeredSituationsPessoal SituationsPessoal[] @relation("registered_by")
  completedSituationsPessoal SituationsPessoal[] @relation("completed_by")

  licensesResp License[] 
  processResp1 Process[] @relation("responsible1")
  processResp2 Process[] @relation("responsible2")
  processResp3 Process[] @relation("responsible3")

  colaborator Colaborators[]
  emergencyContacts EmergencyContacts[]
  allergies Allergies[]
  pointConfig PointsConfig[]
  timeSheets TimeSheets[]
  points Point[]
  timeBankRealeases TimeBankReleases[] @relation("user")
  timeBankRealeasesAdded TimeBankReleases[] @relation("add")
  timeClockRequest TimeClockRequest[] @relation("user")
  timeClockRequestApproved TimeClockRequest[] @relation("approver")
  scores ScoreQuarter[]
  scoresEvaluaion ScoreEvaluation[]
  requesterRH RhRequest[] @relation("RequestOwner")
  assignerRH RhRequest[] @relation("RequestAssignee")
  senderMsgRH RhMessage[]

  passwords PasswordTecnologia[]
  extensions ExtensionsTecnologia[]
  myInventory InventoryTecnologia[] @relation("user")
  staffInventory InventoryTecnologia[] @relation("staff")
  terms TermTecnologia[]
  requestsTI TIRequest[] @relation("TiRequester")
  assigneerRequestsTI TIRequest[] @relation("TiAssignee")
  senderMsgTI TIMessage[]

  triageMonthlys TriageMonthly[]
  responsiblesTriage TriageResponsible[]
}
model Permission {
  id String @id @default(uuid())
  user_id String
  atendimento Int?
  certificado Int?
  comercial Int?
  contabil Int?
  financeiro Int?
  fiscal Int?
  integracao Int?
  marketing Int?
  parcelamento Int?
  pec Int?
  pessoal Int?
  regularize Int?
  rh Int?
  triagem Int?
  wiki Int?

  @@map("permissions")

  user User @relation(fields: [user_id], references: [id])
}
model PermissionSpecific {
  user_id String @id
  task_completion Boolean? // Permissão de concluir tarefas

  @@map("permissions.specific")

  user User @relation(fields: [user_id], references: [id])
}
model PermissionProject {
  user_id                 String      @id
  block_tasks             Boolean
  urgent_tasks_monitoring Boolean

  @@map("permissions.project")
}
// ------------ Core ------------ //

// ------------ Logs ------------
model Logs {
  id String @id @default(uuid())
  user_id String
  action String
  referring String
  referring_id String
  changes Json
  date DateTime @default(now())

  @@map("logs")

  user User @relation(fields: [user_id], references: [id])
}
model LogsPessoal {
  id String @id @default(uuid())
  user_id String
  action String
  referring String
  referring_id String
  changes Json
  date DateTime @default(now())

  @@map("logs.pessoal")

  user User @relation(fields: [user_id], references: [id])
}
// ------------ Logs ------------ //

// ------------ Notifications ------------ 
model CertificateNotification {
  id              String      @id @default(uuid())
  certificate_id  String      // Certificado ID
  client_name     String      // Nome do Cliente
  type            String      // Tipo
  date            DateTime    // Data

  @@map("notification.certificate")
}
model PessoalNotification {
  id              String      @id @default(uuid())
  user_id         String      // Usuário ID
  regarding       String      // Referente
  regarding_id    String      // Referente ID
  title           String      // Título
  message         String      // Mensagem
  read            Boolean     @default(false) // Lida
  create_at       DateTime    @default(now()) // Data de criação

  @@map("notification.pessoal")
}
model RegularizeNotification {
  id              String      @id @default(uuid())
  user_id         String      // Usuário ID
  regarding       String      // Referente
  regarding_id    String      // Referente ID
  title           String      // Título
  message         String      // Mensagem
  read            Boolean     @default(false) // Lida
  create_at       DateTime    @default(now()) // Data de criação

  @@map("notification.regularize")
}
// ------------ Notifications ------------ //


// ------------ Chat ------------
enum ChatType {
  DIRECT
  GROUP
}
enum Role {
  ADMIN
  MEMBER
}
enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DELETED
}
model Chat {
  id  String @id @default(uuid())
  type ChatType // Enum para diferenciar: DIRECT ou GROUP
  name String
  photo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")

  participants ChatParticipant[]
  messages Message[]
}
model ChatParticipant {
  id String @id @default(uuid())
  chat_id String
  user_id String
  role Role @default(MEMBER)
  joinedAt DateTime @default(now())
  unreadCount Int @default(0)
  
  @@map("chats.participants")

  @@unique([chat_id, user_id]) 

  chat Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
model Message {
  id String @id @default(uuid())
  content String? @db.Text
  fileUrl String?
  type MessageType @default(TEXT)
  isEdited  Boolean @default(false) 
  createdAt DateTime @default(now())
  chat_id String
  sender_id String

  @@map("chats.messages")

  chat Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  sender User @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  // Para a função de busca do WhatsApp, precisamos de um índice de texto completo
  @@index([chat_id])
}
// ------------ Chat ------------ //

// ------------ Client ------------
model Client {
  id String @id @default(uuid())
  type String @default("PJ") // Tipo de cliente
  dominio_code String? // Código do domínio
  name String // Nome do cliente
  company_name String? // Razão social
  fantasy_name String? // Nome fantasia
  cpf_cnpj String @default("") // CPF | CNPJ
  cnae String? // CNAE
  cnae_secondary String? // CNAE Secundario
  responsible String? // Nome do responsável
  cpf_responsible String? // CPF do responsável
  agent String? // Nome do preposto
  cpf_agent String? // CPF do preposto
  number String? // Número
  email String? // E-mail
  address String? // Endereço
  cep String? // CEP
  neighborhood String? // Bairro
  state String? // Estado
  city String? // Cidade
  customer_since DateTime? // Cliente desde
  municipal_registration String? // Inscrição municipal
  state_registration String? // Inscrição estadual
  commercial_board_registration String? // Registro na junta comercial
  status String // Status do cliente
  competence_entry DateTime? // Data de entrada do cliente
  competence_output DateTime? // Data de saída do cliente
  opening_date DateTime? // Data de abertura
  instagram String? // Instagram
  indication String? // Indicação
  participants_meet String? // Participantes da reunião
  meet_type String? // Tipo de reunião
  type_registration String @default("Novo")// Tipo de cadastro

  // Coringa
  regime String? // Regime
  size String? // Tamanho
  segment String? // Segmento
  contabil Boolean?
  fiscal Boolean?
  pessoal Boolean?
  infoproduto Boolean?
  consultoria Boolean?
  castelo_med Boolean?
  start_strike DateTime? // Data de início da paralisação
  end_strike DateTime?  // Data de fim da paralisação
  deletion_date DateTime? // Data de exclusão

  // Financeiro / Comercial
  contract Boolean? // Contrato
  prospecting_status String // Status da prospecção
  date_status DateTime? // Data do status
  description_prospecting String? // Descrição da prospecção
  register_date_prospecting DateTime @default(now())
  closing_date DateTime? // Data do fechamento

  // Tipo de cliente
  service_unique Boolean?

  @@map("clients")

  agenda Agenda[]
  agendaRecurring RecurringAgenda[]
  historys ClientHistory[]
  historysPe ClientHistoryPending[]
  notes Note[]
  
  projects Project[]
  tasks Task[]
  pa PA[]
  groups ClientsGroup[]
  
  termination ClientTermination[]
  documentsTermination DocumentClientTermination[]
  
  controlContabil ControlContabil[]
  responsibleContabil ResponsibleContabil[]
  relationshipContabil RelationshipContabil[]
  installments  Installment[]
  panoramasParcelameto PanoramaParcelameto[]

  lddPessoal LddPessoal[]
  passPessoal PasswordPessoal[]
  obrigationsPessoal ObrigationsPessoal[]
  situationsPessoal SituationsPessoal[]

  passRegularize PasswordRegularize[]
  licenses License[]
  process Process[]
  partners Partners[]
  municipalTaxes MunicipalTaxes[]

  triageConfigs TriageConfig[]
  triageMonthlys TriageMonthly[]
  clouds ClientClouds[]
  responsiblesTriage TriageResponsible[]
}

model PA {
  client_id                   String      @id
  activities                  String?     // Atividades
  tax_billing                 String?     // Faturamento Mensal Medio Fiscal
  management_billing          String?     // Faturamento Messal Medio Gerencial
  works_bidding               Boolean?    // Trabalha com Licitação
  dissatisfaction             String?     // Insatisfação - Motivo de mudança de contabilidade
  registered_collabortors     Int?        // Colaboradores Registrados
  unregistered_collabortors   Int?        // Colaboradores Não Registrados
  esocial                     Boolean?    // E-social
  how_many_banks              Boolean?    // Quantos Bancos
  whitch_banks                String?     // Quais Bancos
  responsible_departments     String?     // Responsáveis pelos Departamentos
  works_system                Boolean?    // Trabalha com sistema
  system_name                 String?     // Nome do Sistema
  system_usage_time           String?     // Tempo de uso do Sistema
  system_value                String?     // Valor do sistema
  system_contact              String?     // Contato do Sistema
  system_operations           String?     // Operações do sistema
  cloud_storage               Boolean?    // Armazenamento em nuvem
  which_cloud_storage         String?     // Qual armazenamento em nuvem
  rental_agreement            Boolean?    // Contrato de alguel
  assessment_regime           String?     // Regime de apuração
  permit                      String?     // Alvará
  services                    String?     // Serviços

  @@map("clients.pa")

  client Client @relation(fields: [client_id], references: [id])
}

model ClientHistory {
  id            String    @id @default(uuid())
  client_id     String    // ID do cliente
  date          DateTime  // Data
  history       String    // Histórico
  file          String?   // Arquivo
  user_id       String    // ID do usuário

  @@map("clients.history")

  client Client @relation(fields: [client_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
}
model ClientHistoryPending {
  id        String      @id @default(uuid())
  user_id   String
  client_id String
  reason    String      // Motivo

  @@map("clients.historyPending")

  user User @relation(fields: [user_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])
}

model Group {
  id        String      @id @default(uuid())
  name      String      // Nome do grupo
  status    Boolean     @default(true) // Status

  @@map("clients.group")

  clients ClientsGroup[]
}
model ClientsGroup {
  id        String      @id @default(uuid())
  group_id  String      // ID do grupo
  client_id String      // ID do cliente

  @@map("clients.clientsGroup")

  group Group @relation(fields: [group_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])
}

model ClientTermination {
  id              String      @id @default(uuid())
  client_id       String      // ID do cliente
  reason          String      // Motivo
  description     String      // Descrição
  competence      String      // Competência
  date            DateTime    @default(now()) // Data
  user_id         String      // ID do usuário

  @@map("clients.termination")

  client Client @relation(fields: [client_id], references: [id])
}
model DocumentClientTermination {
  id                            String      @id @default(uuid())
  client_id                     String      // ID do cliente
  address                       String      // Endereço
  legal_representative_name     String      // Nome do representante legal
  legal_representative_cpf      String      // CPF do representante legal
  legal_representative_rg       String      // RG do representante legal
  third_clause_competence       String      // Competência Cláusula Terceira
  fourh_clause_competence       String      // Competência Cláusula Quarta
  sixth_clause_type             String      // Tipo Cláusula Sexta
  date                          DateTime    // Data

  @@map("clients.documentTermination")

  client Client @relation(fields: [client_id], references: [id])
}
// ------------ Client ------------ //

