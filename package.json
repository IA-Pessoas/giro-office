{
  "name": "@workspace/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:reset && turbo run dev --parallel",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome lint .",
    "dev:app": "turbo run dev --filter=@workspace/app",
    "dev:api": "turbo run dev --filter=@workspace/legacy-api",
    "dev:gateway": "turbo run dev --filter=@workspace/gateway",
    "build:gateway": "turbo run build --filter=@workspace/gateway",
    "prisma:generate": "pnpm --filter @workspace/infra run prisma:generate",
    "prisma:migrate": "pnpm --filter @workspace/infra run prisma:migrate",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^25.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@prisma/client": "7.4.1"
  },
  "pnpm": {
    "overrides": {
      "prisma": "7.4.1",
      "@prisma/client": "7.4.1"
    }
  },
  "lint-staged": {
    "{shared,services/gateway}/**/*.{ts,tsx,js,json}": [
      "biome format --write",
      "biome lint"
    ]
  }
}
