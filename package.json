{
  "name": "@workspace/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:reset && turbo run dev --parallel --concurrency=20",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint .",
    "dev:app": "turbo run dev --filter=@workspace/app",
    "dev:api": "turbo run dev --filter=@workspace/legacy-api",
    "dev:gateway": "turbo run dev --filter=@workspace/gateway",
    "build:gateway": "turbo run build --filter=@workspace/gateway",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "prisma:migrate": "pnpm --filter @workspace/infra run prisma:migrate",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "audit:ci": "pnpm audit --audit-level moderate",
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe .",
    "smoke": "node scripts/all-services-smoke.mjs",
    "smoke:coverage": "node scripts/check-smoke-spec-coverage.mjs",
    "smoke:scaffold": "node scripts/generate-service-harness.mjs",
    "harness:test": "node --test scripts/service-harness.test.mjs scripts/check-compose-security.test.mjs scripts/ci-workflow-optimization.test.mjs",
    "security:compose": "node scripts/check-compose-security.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^25.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@prisma/client": "7.4.1"
  },
  "pnpm": {
    "overrides": {
      "@biomejs/biome": "2.4.5",
      "typescript": "5.3.3",
      "prisma": "7.4.1",
      "@prisma/client": "7.4.1",
      "hono": "4.12.18",
      "@hono/node-server": "1.19.13",
      "effect": "3.20.0",
      "lodash": "4.18.0",
      "follow-redirects": "1.16.0",
      "cookie": "0.7.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.11"
    }
  },
  "lint-staged": {
    "{shared,services/gateway}/**/*.{ts,tsx,js,json}": [
      "biome format --write",
      "biome lint"
    ]
  }
}
